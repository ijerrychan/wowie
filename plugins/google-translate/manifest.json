{
  "id": "google-translate",
  "name": "Google Translate",
  "version": "0.1.0",
  "api_version": 1,
  "entry_point": "main.lua",
  "permissions": ["network"],
  "preferences": [{
    "key": "google_api_key",
    "title": "Google Translate API key",
    "description": "Optional API key for the translation service.",
    "type": "password",
    "default": ""
  }],
  "engine": {
    "participates_in_root": true,
    "respect_global_fuzzy_search": true,
    "ranking_bias": 0,
    "search_debounce_ms": 400
  },
  "commands": [{
    "id": "translate",
    "title": "Google Translate",
    "action_words": ["gt", "tmt"],
    "mode": "search",
    "placeholder": "Enter text to translate",
    "require_separator": true,
    "icon": {"type": "resource", "path": "icons/google-translate.svg"}
  }]
}
