import { VerticalBox, ListView } from "std-widgets.slint";

export struct ResultRow { id: string, title: string, location: string, location_kind: string, icon: image, category: string }
export struct ContextActionRow { id: string, title: string, subtitle: string, kind: string }
export struct DetailBlock { kind: string, label: string, value: string, color: string }

component SearchGlyph inherits Rectangle {
    background: transparent;
    Image { x: 2px; y: 2px; width: 20px; height: 20px; source: @image-url("../wowie.png"); image-fit: contain; }
}

export component Launcher inherits Window {
    title: "Wowie";
    no-frame: true;
    width: window-width * 1px;
    height: search-field.text == "" ? 68px : detail-visible ? (100px + root.detail-panel-height) : results.length > 0 ? min(506px, 108px + results.length * root.result-row-height) : 192px;
    background: transparent;

    in-out property <int> window-width: 900;
    in property <bool> dark-mode: true;
    in property <color> accent-color: #0067c0;
    in property <color> accent-background: #280067c0;
    in property <int> result-count: 0;
    in property <bool> detail-panel-visible: false;
    in property <string> detail-title: "";
    in property <string> detail-subtitle: "";
    in property <string> detail-source: "";
    in property <[DetailBlock]> detail-blocks;
    in property <[ContextActionRow]> detail-actions;
    in-out property <string> launch-error: "";
    in-out property <string> last-action-id: "";
    in-out property <string> last-action-result: "";
    in-out property <string> last-action-subtitle: "";
    in property <[ResultRow]> results;
    in property <bool> context-menu-open: false;
    in-out property <int> selected-index: -1;
    callback query-changed(string);
    callback visible-range-changed(int, int);
    callback selection-changed(int);
    callback launch-requested(int);
    callback detail-action-requested(int);
    callback context-menu-requested(int);
    callback context-menu-dismissed;
    callback dismiss-requested;

    private property <length> result-row-height: 56px;
    private property <length> detail-panel-height: max(340px, 118px + root.detail-blocks.length * 60px + (root.detail-actions.length > 0 ? 50px : 0px));
    private property <bool> detail-visible: root.detail-panel-visible && root.selected-index >= 0;
    private property <int> first-visible-index: max(0, round(-results-list.content-y / root.result-row-height));
    private property <bool> context-click-consumed: false;
    private property <int> last-visible-index: min(root.results.length, round((-results-list.content-y + results-list.visible-height) / root.result-row-height) + 1);
    private property <color> canvas: root.dark-mode ? #202020 : #f8f9fb;
    private property <color> surface: root.dark-mode ? #292929 : #ffffff;
    private property <color> surface-hover: root.dark-mode ? #323232 : #f1f3f6;
    private property <color> surface-selected: root.accent-background;
    private property <color> border: root.dark-mode ? #484848 : #d9dde5;
    private property <color> text-primary: root.dark-mode ? #f5f5f5 : #1b1b1f;
    private property <color> text-secondary: root.dark-mode ? #b6b6b6 : #5d5f66;
    private property <color> text-tertiary: root.dark-mode ? #858585 : #797b82;
    private property <color> accent: root.accent-color;

    function ensure-selected-visible() {
        if (root.selected-index < 0 || root.selected-index >= root.results.length) { return; }
        if (root.selected-index * root.result-row-height + results-list.content-y < 0px) {
            results-list.content-y = min(0px, max(results-list.visible-height - results-list.content-height, -root.selected-index * root.result-row-height));
        }
        if (root.selected-index * root.result-row-height + root.result-row-height + results-list.content-y > results-list.visible-height) {
            results-list.content-y = min(0px, max(results-list.visible-height - results-list.content-height, results-list.visible-height - (root.selected-index + 1) * root.result-row-height));
        }
    }

    changed selected-index => {
        root.ensure-selected-visible();
        root.selection-changed(root.selected-index);
    }
    changed first-visible-index => { root.visible-range-changed(root.first-visible-index, root.last-visible-index); }
    changed last-visible-index => { root.visible-range-changed(root.first-visible-index, root.last-visible-index); }

    Rectangle {
        x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
        background: root.canvas;
        border-color: root.border;
        border-width: 1px;
        // Keep the shell flat and avoid a rounded clip layer on every frame.
        border-radius: 12px;

        VerticalBox {
            padding: 10px;
            spacing: 8px;

            search-surface := Rectangle {
                height: 40px;
                background: transparent;

                SearchGlyph { x: 14px; y: 8px; width: 24px; height: 24px; }
                Text { x: 48px; y: 0px; width: parent.width - 126px; height: parent.height; text: @tr("Search applications"); color: root.text-tertiary; font-size: 16px; vertical-alignment: center; visible: search-field.text == ""; }
                search-field := TextInput {
                    x: 48px; y: 0px; width: parent.width - 126px; height: parent.height;
                    color: root.text-primary; font-size: 16px; vertical-alignment: center; single-line: true;
                    selection-background-color: root.accent-color;
                    selection-foreground-color: #ffffff;
                    edited => { root.query-changed(self.text); }
                    key-pressed(event) => {
                        if (event.text == Key.DownArrow) { root.selected-index = min(root.selected-index + 1, root.results.length - 1); accept }
                        if (event.text == Key.UpArrow) { root.selected-index = max(root.selected-index - 1, 0); accept }
                        if (event.text == Key.Return && root.selected-index >= 0) { root.launch-requested(root.selected-index); accept }
                        if (event.text == Key.Escape) { root.dismiss-requested(); accept }
                        reject
                    }
                }
                Text { x: parent.width - 122px; y: 0px; width: 92px; height: parent.height; text: @tr("{} results", root.result-count); color: root.text-tertiary; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; visible: search-field.text != ""; }
            }

            results-area := Rectangle {
                height: root.detail-visible ? root.detail-panel-height : min(398px, root.results.length * root.result-row-height);
                background: transparent;

                results-list := ListView {
                    x: 0px; y: 0px;
                    width: parent.width - (root.detail-visible ? parent.width / 2 + 12px : 0px);
                    height: parent.height;
                for row[index] in root.results : Rectangle {
                    height: root.result-row-height;
                    // A single flat row background replaces the old Fluent-like
                    // rounded selection plus accent indicator.
                    background: index == root.selected-index ? root.surface-selected : transparent;
                    item-area := TouchArea {
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                root.context-menu-requested(index);
                                EventResult.accept
                            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down && root.context-menu-open) {
                                root.context-click-consumed = true;
                                root.context-menu-dismissed();
                                EventResult.accept
                            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                if (root.context-click-consumed) {
                                    root.context-click-consumed = false;
                                    EventResult.accept
                                } else {
                                    root.launch-requested(index);
                                    EventResult.accept
                                }
                            } else {
                                EventResult.reject
                            }
                        }
                    }
                    Image { x: 18px; y: 16px; width: 24px; height: 24px; source: row.icon; image-fit: contain; }
                    VerticalBox {
                        x: 60px; y: 5px; width: parent.width - 76px; height: 40px; spacing: 2px;
                        Text { text: row.id == root.last-action-id && root.last-action-result != "" ? root.last-action-result : row.title; color: root.text-primary; font-size: 14px; font-weight: 500; overflow: elide; }
                        Text { width: parent.width - 4px; text: row.id == root.last-action-id && root.last-action-subtitle != "" ? root.last-action-subtitle : row.location_kind == "store-application" ? @tr("Store application") : row.location; color: root.text-secondary; font-size: 11px; overflow: elide; }
                    }
                    Text {
                        x: parent.width - 76px; y: 17px; width: 68px; height: 22px;
                        text: row.category == "game" ? @tr("Game") : row.category == "website" ? @tr("Website") : row.category == "shortcut" ? @tr("Shortcut") : row.category == "document" ? @tr("Document") : row.category == "other" ? @tr("Other") : row.category == "control-panel" ? @tr("Control Panel") : @tr("Application");
                        color: root.text-tertiary; font-size: 10px;
                        horizontal-alignment: center; vertical-alignment: center;
                        visible: !root.detail-visible;
                    }
                }
                }

                if (root.detail-visible) : Rectangle {
                    x: parent.width / 2; y: 0px; width: parent.width / 2; height: parent.height;
                    background: root.dark-mode ? #242424 : #fbfcfe;

                    Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: root.border; }

                    Text { x: 20px; y: 18px; width: parent.width - 40px; height: 24px; text: root.detail-title; color: root.text-primary; font-size: 17px; font-weight: 600; overflow: elide; }
                    Text { x: 20px; y: 44px; width: parent.width - 40px; height: 18px; text: root.detail-subtitle; color: root.text-secondary; font-size: 11px; overflow: elide; }
                    VerticalBox {
                        x: 20px; y: 76px; width: parent.width - 40px; height: parent.height - (root.detail-actions.length > 0 ? 168px : 118px); spacing: 6px;
                        for block in root.detail-blocks : Rectangle {
                            height: block.kind == "metric" ? 48px : block.kind == "weather" ? 48px : block.kind == "separator" ? 1px : block.kind == "icon" ? 40px : 24px;
                            background: transparent;
                            if (block.kind == "text") : Text {
                                width: parent.width; height: parent.height; text: block.value; color: block.color == "primary" ? root.text-primary : block.color == "accent" ? root.accent : root.text-secondary; font-size: 13px; vertical-alignment: center; overflow: elide;
                            }
                            if (block.kind == "metric") : Rectangle {
                                width: parent.width; height: parent.height; background: root.dark-mode ? #2b2b2b : #f1f3f6; border-radius: 8px;
                                Text { x: 10px; y: 8px; width: parent.width - 20px; height: 14px; text: block.label; color: root.text-tertiary; font-size: 10px; }
                                Text { x: 10px; y: 26px; width: parent.width - 20px; height: 18px; text: block.value; color: block.color == "accent" ? root.accent : root.text-primary; font-size: 13px; font-weight: 600; overflow: elide; }
                            }
                            if (block.kind == "icon") : Text { width: parent.width; height: parent.height; text: block.value; color: block.color == "accent" ? root.accent : root.text-primary; font-size: 32px; horizontal-alignment: center; vertical-alignment: center; }
                            if (block.kind == "separator") : Rectangle { y: 0px; width: parent.width; height: 1px; background: transparent; }
                            if (block.kind == "weather") : Text {
                                width: parent.width; height: parent.height;
                                text: block.value == "clear" ? "☀" : block.value == "snow" ? "❄" : block.value == "storm" ? "⚡" : block.value == "rain" ? "☂" : "☁";
                                color: block.value == "clear" ? #ffc144 : block.value == "storm" ? #ffd34e : block.value == "rain" ? #4da3e6 : #b8c5d4;
                                font-size: 38px; horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                    for action[index] in root.detail-actions : Rectangle {
                        x: 20px + index * 104px; y: parent.height - 78px; width: 96px; height: 28px;
                        background: action-area.has-hover ? root.surface-hover : root.dark-mode ? #2b2b2b : #f1f3f6;
                        border-color: root.border; border-width: 1px; border-radius: 7px;
                        action-area := TouchArea { clicked => { root.detail-action-requested(index); } }
                        Text { x: 8px; y: 0px; width: parent.width - 16px; height: parent.height; text: action.title; color: root.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    }
                    Text { x: 20px; y: parent.height - 42px; width: parent.width - 40px; height: 18px; text: root.detail-source; color: root.text-tertiary; font-size: 10px; overflow: elide; }
                }
            }

            if (root.results.length == 0 && search-field.text != "") : Rectangle { height: 76px; background: transparent; Text { text: @tr("No results"); color: root.text-secondary; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; } }

            if (search-field.text != "") : Rectangle {
                height: 24px; background: transparent;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: root.border; }
                Text { x: 10px; y: 1px; width: parent.width - 20px; height: parent.height - 1px; text: @tr("↑ ↓  Navigate     Enter  Open     Esc  Hide"); color: root.text-tertiary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
    if (root.launch-error != "") : Rectangle {
        x: 18px; y: parent.height - 38px; width: parent.width - 36px; height: 26px;
        background: root.dark-mode ? #3b2525 : #fff0f0;
        border-color: #b85c5c; border-width: 1px; border-radius: 6px;
        Text { x: 8px; y: 0px; width: parent.width - 16px; height: parent.height; text: @tr("Could not open application") + ": " + root.launch-error; color: #d96c6c; font-size: 11px; vertical-alignment: center; overflow: elide; }
    }
}

export component ContextMenu inherits Window {
    title: "Wowie Context Menu";
    no-frame: true;
    width: 292px;
    height: max(48px, 16px + root.actions.length * 32px);
    background: transparent;

    in property <bool> dark-mode: true;
    in property <color> accent-color: #0067c0;
    in property <[ContextActionRow]> actions;
    callback action-requested(string);
    callback dismissed;

    private property <color> canvas: root.dark-mode ? #202020 : #f8f9fb;
    private property <color> surface: root.dark-mode ? #292929 : #ffffff;
    private property <color> hover: root.dark-mode ? #383838 : #eef1f5;
    private property <color> border: root.dark-mode ? #484848 : #d9dde5;
    private property <color> text-primary: root.dark-mode ? #f5f5f5 : #1b1b1f;
    private property <color> text-secondary: root.dark-mode ? #b6b6b6 : #5d5f66;

    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: root.canvas;
        border-color: root.border;
        border-width: 1px;
        border-radius: 8px;

        for action[index] in root.actions : Rectangle {
            x: 1px; y: 8px + index * 32px; width: parent.width - 2px; height: 32px;
            background: action.kind == "section" ? root.canvas : action-area.has-hover ? root.hover : root.canvas;
            action-area := TouchArea {
                enabled: action.kind != "section";
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                        root.action-requested(action.id);
                        EventResult.accept
                    } else {
                        EventResult.reject
                    }
                }
            }
            VerticalBox {
                x: 14px; y: 1px; width: parent.width - 28px; height: 30px; spacing: 0px;
                Text { text: action.kind == "section" ? @tr("Other launch entries") : action.id == "open-directory" ? @tr("Open containing folder") : action.id == "run-as-admin" ? @tr("Run as administrator") : action.title; color: action.kind == "section" ? root.text-secondary : root.text-primary; font-size: action.kind == "section" ? 11px : 13px; vertical-alignment: center; overflow: elide; }
                Text { text: action.subtitle; color: root.text-secondary; font-size: 10px; vertical-alignment: center; overflow: elide; visible: action.subtitle != ""; }
            }
        }
    }

}
