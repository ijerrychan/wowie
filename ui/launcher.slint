import { VerticalBox, ScrollView, Palette } from "std-widgets.slint";
import { DesignTokens } from "design-system.slint";

export struct ResultRow { id: string, title: string, location: string, location_kind: string, icon: image, icon_kind: string, favorite: bool, shortcut_prefix: string, shortcut_prefix_width: int, presentation: string, category_kind: string, section_kind: string, section_count: int, section_more_key: string, headers_before: int, is_best_match: bool }
export struct CategoryFilter { key: string, count: int }
export struct ContextActionRow { id: string, title: string, subtitle: string, kind: string, icon: image, icon_kind: string, shortcut: string }
export struct DetailBlock { kind: string, label: string, value: string, color: string, secondary: string, icon: image, height: int }

component BuiltinIcon inherits Image {
    in property <string> kind;
    visible: root.kind != "";
    image-fit: contain;
    source: root.kind == "weather" ? @image-url("../assets/icons/weather.svg")
        : root.kind == "calculator" ? @image-url("../assets/icons/calculator.svg")
        : root.kind == "book" ? @image-url("../assets/icons/book-open.svg")
        : root.kind == "bookmark" ? @image-url("../assets/icons/bookmark-outline.svg")
        : root.kind == "window" ? @image-url("../assets/icons/window.svg")
        : root.kind == "checklist" ? @image-url("../assets/icons/list-checks.svg")
        : root.kind == "folder-open" ? @image-url("../assets/icons/folder-open-outline.svg")
        : root.kind == "shield-account" ? @image-url("../assets/icons/shield-account-outline.svg")
        : root.kind == "content-copy" ? @image-url("../assets/icons/content-copy.svg")
        : root.kind == "star" ? @image-url("../assets/icons/star.svg")
        : root.kind == "magnify" ? @image-url("../assets/icons/magnify.svg")
        : root.kind == "arrow-left-dark" ? @image-url("../assets/icons/arrow-left-dark.svg")
        : root.kind == "arrow-left-light" ? @image-url("../assets/icons/arrow-left-light.svg")
        : @image-url("../wowie.png");
}

component SearchGlyph inherits Rectangle {
    in property <image> source-image;
    in property <string> source-kind;
    in property <image> previous-image;
    in property <string> previous-kind;
    in property <float> transition-progress: 1.0;
    in property <bool> transition-animation-enabled: true;
    in property <bool> animations-enabled: true;
    background: transparent;
    clip: true;

    private property <float> animated-progress: root.transition-progress;
    private property <float> outgoing-scale: max(0.0, 1.0 - root.animated-progress);
    private property <float> incoming-scale: 0.72 + root.animated-progress * 0.28;
    animate animated-progress {
        duration: DesignTokens.motion-icon;
        easing: ease-out;
        enabled: root.transition-animation-enabled && root.animations-enabled;
    }

    Rectangle {
        x: (parent.width - parent.width * root.outgoing-scale) / 2;
        y: (parent.height - parent.height * root.outgoing-scale) / 2;
        width: parent.width * root.outgoing-scale;
        height: parent.height * root.outgoing-scale;
        background: transparent;
        BuiltinIcon {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            kind: root.previous-kind;
            opacity: max(0.0, 1.0 - root.animated-progress);
        }
        if root.previous-kind == "" : Image {
            width: parent.width; height: parent.height;
            source: root.previous-image.width > 0 ? root.previous-image : @image-url("../assets/icons/magnify.svg");
            image-fit: contain;
            opacity: max(0.0, 1.0 - root.animated-progress);
        }
    }

    Rectangle {
        x: (parent.width - parent.width * root.incoming-scale) / 2;
        y: (parent.height - parent.height * root.incoming-scale) / 2;
        width: parent.width * root.incoming-scale;
        height: parent.height * root.incoming-scale;
        background: transparent;
        BuiltinIcon {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            kind: root.source-kind;
            opacity: min(1.0, root.animated-progress);
        }
        if root.source-kind == "" : Image {
            width: parent.width; height: parent.height;
            source: root.source-image.width > 0 ? root.source-image : @image-url("../assets/icons/magnify.svg");
            image-fit: contain;
            opacity: min(1.0, root.animated-progress);
        }
    }
}

// Keep this name aligned with the existing ContextMenu translation context.
component ContextMenu inherits Rectangle {
    forward-focus: focus-scope;
    background: transparent;

    in property <bool> dark-mode: true;
    in property <[ContextActionRow]> actions;
    in property <bool> keyboard-invoked: false;
    callback action-requested(string);
    callback dismissed;
    private property <int> selected-action-index: 0;

    private property <color> canvas: root.dark-mode ? DesignTokens.dark-surface : DesignTokens.light-surface;
    private property <color> hover: root.dark-mode ? DesignTokens.dark-raised : DesignTokens.light-raised;
    private property <length> menu-item-height: DesignTokens.control-height;
    private property <color> border: root.dark-mode ? DesignTokens.dark-border : DesignTokens.light-border;
    private property <color> text-primary: root.dark-mode ? DesignTokens.dark-primary : DesignTokens.light-primary;
    private property <color> text-secondary: root.dark-mode ? DesignTokens.dark-secondary : DesignTokens.light-secondary;

    changed selected-action-index => {
        if (root.selected-action-index >= 0) {
            let top = DesignTokens.space-1 + root.selected-action-index * root.menu-item-height;
            let bottom = top + root.menu-item-height;
            if (top + action-list.content-y < 0px) { action-list.content-y = -top; }
            if (bottom + action-list.content-y > action-list.visible-height) {
                action-list.content-y = min(0px, action-list.visible-height - bottom);
            }
        }
    }

    function reset-selection() {
        root.selected-action-index = root.keyboard-invoked
            ? root.actions.length == 0 ? -1 : root.actions[0].kind == "section" ? (root.actions.length > 1 ? 1 : -1) : 0
            : -1;
        action-list.content-y = 0px;
        focus-scope.focus();
    }
    init => { root.reset-selection(); }
    changed actions => { root.reset-selection(); }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.dismissed(); accept }
            if (event.text == Key.DownArrow && root.actions.length > 0) {
                let candidate = root.selected-action-index + 1;
                let wrapped = candidate >= root.actions.length ? 0 : max(candidate, 0);
                let next = root.actions[wrapped].kind == "section" ? (wrapped + 1 >= root.actions.length ? 0 : wrapped + 1) : wrapped;
                root.selected-action-index = next;
                accept
            }
            if (event.text == Key.UpArrow && root.actions.length > 0) {
                let candidate = root.selected-action-index - 1;
                let wrapped = candidate < 0 ? root.actions.length - 1 : candidate;
                let next = root.actions[wrapped].kind == "section" ? (wrapped - 1 < 0 ? root.actions.length - 1 : wrapped - 1) : wrapped;
                root.selected-action-index = next;
                accept
            }
            if (event.text == Key.Home && root.actions.length > 0) {
                root.selected-action-index = root.actions[0].kind == "section" ? (root.actions.length > 1 ? 1 : -1) : 0;
                accept
            }
            if (event.text == Key.End && root.actions.length > 0) {
                let last = root.actions.length - 1;
                root.selected-action-index = root.actions[last].kind == "section" ? max(last - 1, 0) : last;
                accept
            }
            if (event.text == Key.Return && root.selected-action-index >= 0 && root.actions[root.selected-action-index].kind != "section") {
                root.action-requested(root.actions[root.selected-action-index].id);
                accept
            }
            reject
        }

        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            background: root.canvas;
            border-color: root.border;
            border-width: 1px;
            border-radius: DesignTokens.radius-md;

            TouchArea {
                pointer-event(event) => {
                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) { root.dismissed(); }
                }
            }

            action-list := ScrollView {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                content-width: self.visible-width;
                horizontal-scrollbar-policy: always-off;
                content-height: 2 * DesignTokens.space-1 + root.actions.length * root.menu-item-height;
                for action[index] in root.actions : Rectangle {
                    x: DesignTokens.space-1; y: DesignTokens.space-1 + index * root.menu-item-height;
                    width: parent.width - 2 * DesignTokens.space-1; height: root.menu-item-height;
                    background: action.kind == "section" ? root.canvas : index == root.selected-action-index ? root.hover : action-area.has-hover ? root.hover : root.canvas;
                    border-radius: DesignTokens.radius-sm;
                    action-area := TouchArea {
                        enabled: action.kind != "section";
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                root.dismissed();
                                EventResult.accept
                            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                root.action-requested(action.id);
                                EventResult.accept
                            } else {
                                EventResult.reject
                            }
                        }
                    }
                    BuiltinIcon { x: 14px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; kind: action.icon_kind; }
                    if action.icon_kind == "" : Image { x: 14px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: action.icon; image-fit: contain; }
                    Text {
                        x: 36px; y: action.subtitle == "" ? 0px : 2px; width: action.shortcut == "" ? parent.width - 50px : parent.width - 162px;
                        height: action.subtitle == "" ? parent.height : 16px;
                        text: action.kind == "section" ? @tr("Other launch entries") : action.id == "add-favorite" ? @tr("Add to favorites") : action.id == "remove-favorite" ? @tr("Remove from favorites") : action.id == "open-directory" ? @tr("Open containing folder") : action.id == "run-as-admin" ? @tr("Run as administrator") : action.id == "copy-title" ? @tr("Copy title") : action.id == "copy-path" ? @tr("Copy path") : action.id == "copy-url" ? @tr("Copy URL") : action.title;
                        color: action.kind == "section" ? root.text-secondary : root.text-primary;
                        font-size: action.kind == "section" ? DesignTokens.font-small : DesignTokens.font-body;
                        vertical-alignment: center; overflow: elide;
                    }
                    Text { x: 36px; y: 17px; width: action.shortcut == "" ? parent.width - 50px : parent.width - 162px; height: 12px; text: action.subtitle; color: root.text-secondary; font-size: DesignTokens.font-caption; vertical-alignment: center; overflow: elide; visible: action.subtitle != ""; }
                    Text { x: parent.width - 120px; y: 0px; width: 108px; height: parent.height; text: action.shortcut; color: root.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: right; vertical-alignment: center; overflow: elide; visible: action.shortcut != ""; }
                }
            }
        }
    }

}

export component Launcher inherits Window {
    title: "Wowie";
    no-frame: true;
    // Let the winit backend expose native resize cursors and edge/corner
    // dragging for this frameless launcher.
    resize-border-width: 8px;
    preferred-width: window-width * 1px;
    min-width: 520px;
    // With details open, both columns contribute to the window's required
    // height. Using only the detail card here clipped long result lists to a
    // short plugin detail content.
    preferred-height: root.effective-window-height;
    default-font-family: root.ui-font-family;
    default-font-size: root.ui-font-size;
    // Preserve enough room for five rows while allowing the user to resize larger.
    min-height: root.compact-results-hidden ? root.compact-window-height : root.minimum-results-window-height;
    max-height: 1000000px;
    background: root.native-window-frame ? root.canvas : transparent;

    in property <bool> native-window-frame: false;
    out property <color> native-background-color: root.canvas;
    out property <color> native-border-color: root.border;
    in property <bool> animations-enabled: true;
    in-out property <int> window-width: 900;
    in property <string> ui-font-family: "";
    in property <length> ui-font-size: 14px;
    in property <bool> compact-search: false;
    in property <bool> root-query-empty: true;
    in-out property <bool> empty-query-results-visible: false;
    in property <length> list-item-height: 50px;
    in property <bool> dark-mode: true;
    in property <color> accent-color: #0067c0;
    in property <color> accent-background: #280067c0;
    in property <image> search-icon;
    in property <string> search-icon-kind: "";
    in property <image> search-icon-previous;
    in property <string> search-icon-previous-kind: "";
    in property <float> search-icon-transition-progress: 1.0;
    in property <bool> search-icon-animation-enabled: true;
    in-out property <bool> search-icon-is-shortcut: false;
    in-out property <bool> detail-panel-visible: false;
    in-out property <bool> empty-state-detail-active: false;
    in property <string> empty-state-title: "";
    in property <string> empty-state-description: "";
    in property <image> empty-state-icon;
    in property <int> empty-state-icon-generation: 0;
    in property <string> empty-state-icon-kind: "";
    in property <string> detail-title: "";
    in property <string> detail-subtitle: "";
    in property <string> detail-source: "";
    in property <int> detail-content-generation: 0;
    in property <[DetailBlock]> detail-blocks;
    in property <[ContextActionRow]> detail-actions;
    in property <int> detail-panel-preferred-width: 0;
    in property <bool> detail-panel-scrollable: false;
    in-out property <string> launch-error: "";
    in-out property <string> last-action-id: "";
    in-out property <string> last-action-result: "";
    in-out property <string> last-action-subtitle: "";
    in property <[ResultRow]> results;
    in property <[CategoryFilter]> category-filters;
    in property <string> selected-category-filter: "all";
    in property <int> selected-category-index: 0;
    private property <bool> category-filter-keyboard-active: false;
    in-out property <string> query-text: "";
    in-out property <bool> query-results-ready: false;
    in-out property <bool> search-feedback-visible: false;
    in-out property <bool> pagination-feedback-visible: false;
    in-out property <int> query-history-restore-id: 0;
    in-out property <int> query-history-cursor: 0;
    in property <bool> shortcut-session-active: false;
    in property <bool> shortcut-session-execute-mode: false;
    in property <string> shortcut-session-prefix: "";
    in property <string> shortcut-session-placeholder: "";
    in property <bool> context-menu-open: false;
    in property <[ContextActionRow]> context-actions;
    in property <length> context-menu-width: 292px;
    in property <bool> context-keyboard-invoked: false;
    in-out property <length> context-pointer-x: 0px;
    in-out property <length> context-pointer-y: 0px;
    out property <length> context-menu-effective-width: min(root.context-menu-width, max(0px, root.width - 2 * root.window-inset));
    out property <length> context-menu-effective-height: min(max(0px, root.height - 2 * root.window-inset), max(40px, 2px + 2 * DesignTokens.space-1 + root.context-actions.length * DesignTokens.control-height));
    // Mouse menus prefer the click's lower-right; flip at the edges, then
    // clamp so even oversized menus stay inside the launcher's content.
    out property <length> context-menu-x: max(root.window-inset, min(root.width - root.window-inset - root.context-menu-effective-width,
        root.context-keyboard-invoked ? root.context-menu-anchor-x - root.context-menu-effective-width
        : root.context-pointer-x + root.context-menu-effective-width <= root.width - root.window-inset ? root.context-pointer-x : root.context-pointer-x - root.context-menu-effective-width));
    out property <length> context-menu-y: max(root.window-inset, min(root.height - root.window-inset - root.context-menu-effective-height,
        root.context-keyboard-invoked ? root.context-menu-anchor-y - root.context-menu-effective-height
        : root.context-pointer-y + root.context-menu-effective-height <= root.height - root.window-inset ? root.context-pointer-y : root.context-pointer-y - root.context-menu-effective-height));
    callback context-action-requested(string);
    changed context-menu-open => {
        if (!root.context-menu-open) { search-field.focus(); }
    }

    in property <bool> context-menu-available: false;
    in-out property <int> selected-index: -1;
    // Local coordinates of the launcher's visible content bottom-right,
    // immediately above the operation hint. Keep this geometry in Slint so
    // layout changes do not require matching constants in platform code.
    // Expose the effective insets as geometry diagnostics so layout tests
    // and manual layout checks can observe the same values as the anchor.
    out property <length> context-menu-anchor-right-inset: root.window-inset + root.context-menu-gap;
    out property <length> context-menu-anchor-bottom-inset: root.window-inset + root.content-bottom-padding + root.operation-hint-height + root.context-menu-gap;
    out property <length> context-menu-anchor-x: root.width - root.context-menu-anchor-right-inset;
    out property <length> context-menu-anchor-y: root.height - root.context-menu-anchor-bottom-inset;
    callback query-changed(string);
    callback category-filter-selected(string);
    callback compact-results-requested;
    callback normalize-query(string) -> string;
    callback query-history-up-requested;
    callback visible-range-changed(int, int);
    callback selection-changed(int);
    callback launch-requested(int);
    callback shortcut-back-requested;
    callback search-back-requested;
    callback session-execute-requested;
    callback empty-state-activated;

    init => { Palette.color-scheme = root.dark-mode ? dark : light; }
    changed dark-mode => { Palette.color-scheme = root.dark-mode ? dark : light; }
    changed query-history-restore-id => {
        search-field.set-selection-offsets(root.query-history-cursor, root.query-history-cursor);
    }
    callback detail-back-requested;
    callback detail-action-requested(int);
    callback detail-link-requested(string);
    callback context-menu-requested(int, bool);
    callback context-menu-dismissed;
    callback dismiss-requested;

    // Primary density controls. Keep row geometry here so compactness can be tuned centrally.
    private property <length> search-row-height: DesignTokens.row-height;
    private property <length> result-row-height: root.list-item-height;
    private property <length> result-icon-size: 24px;
    private property <length> section-header-height: 27px;
    private property <length> empty-state-padding: 8px;
    private property <length> content-bottom-padding: 4px;
    private property <length> minimum-results-window-height: 100px + 5 * root.result-row-height + (root.category-filters.length > 0 ? root.category-filter-height + 3 * root.category-layout-spacing - 2 * root.content-spacing : 0px);
    in-out property <length> result-window-height: root.minimum-results-window-height;
    out property <length> effective-window-height: root.compact-results-hidden ? root.compact-window-height : root.result-window-height;
    private property <length> compact-window-height: 2 * root.window-inset + 2 * root.empty-state-padding + root.search-row-height;
    private property <bool> compact-results-hidden: root.compact-search && root.root-query-empty && !root.shortcut-session-active && !root.empty-query-results-visible;
    private property <length> operation-hint-height: 24px;
    private property <length> context-menu-gap: DesignTokens.space-2;
    private property <length> no-results-height: 160px;
    private property <length> window-inset: root.native-window-frame ? 0px : 4px;
    private property <length> content-padding: DesignTokens.space-3;
    private property <length> content-spacing: DesignTokens.space-2;
    private property <length> category-filter-height: 28px;
    private property <length> category-button-height: DesignTokens.control-height-compact;
    private property <length> category-button-width: 98px;
    private property <length> category-filter-step: 102px;
    private property <length> category-layout-spacing: root.category-filters.length > 0 ? DesignTokens.space-2 : root.content-spacing;
    private property <length> result-row-inset: 2px;
    private property <length> result-column-gap: 8px;
    private property <length> detail-panel-inset: 2px;
    // Shift the list/panel split so the selected row's right edge and the
    // panel's left edge are equally far from the window center line. Both
    // edges move together, preserving their existing 8px separation.
    private property <length> detail-panel-alignment-shift: 6px;
    private property <length> detail-panel-bottom-inset: 6px;
    private property <float> detail-panel-share: root.detail-panel-preferred-width > 0 && root.width > 0px ? root.detail-panel-preferred-width / (root.width / 1px) : 0.5;
    // Text blocks may wrap into several lines. Keep enough measured content
    // height for the Flickable to expose a real scroll range instead of
    // clipping the tail of a long translation.
    in property <length> detail-content-height: 0px;
    private property <length> detail-block-spacing: 6px;
    private property <length> detail-action-footer-extra: 50px;
    private property <length> detail-panel-content-height: root.detail-content-footer-height + root.detail-content-height + (root.detail-actions.length > 0 ? root.detail-action-footer-extra : 0px);
    private property <length> operation-hint-spacing: root.category-layout-spacing + root.operation-hint-height;
    private property <length> no-results-spacing: 0px;
    // Keep the search glyph and text anchored across session changes. Only
    // the back affordance appears/disappears; input never slides under typing.
    private property <length> session-back-width: 22px;
    private property <length> search-icon-x: 28px;
    private property <length> search-input-x: 52px;
    // Keep the placeholder and the focused text at the same six-pixel inset.
    // Cursor visibility uses the same margin when the field receives focus.
    private property <length> search-input-scroll-x: 6px;
    private property <length> search-row-layout-height: root.search-row-height;
    private property <length> available-results-height: root.compact-results-hidden ? 0px : max(0px, root.height - 2 * root.window-inset - root.empty-state-padding - root.content-bottom-padding - root.search-row-layout-height - root.category-layout-spacing - (root.category-filters.length > 0 ? root.category-filter-height + root.category-layout-spacing : 0px) - root.operation-hint-spacing - root.no-results-spacing);
    private property <bool> detail-visible: root.detail-panel-visible && (root.selected-index >= 0 || root.empty-state-detail-active);
    private property <length> detail-panel-width: (root.width - 2 * root.window-inset - 2 * root.content-padding) * root.detail-panel-share - root.detail-panel-alignment-shift;
    private property <bool> detail-panel-active: root.detail-visible;
    private property <length> detail-content-inset: 20px;
    private property <length> detail-header-top: 18px;
    private property <length> detail-subtitle-top: 44px;
    private property <length> detail-content-top: 76px;
    private property <length> detail-content-footer-height: 118px;
    private property <length> detail-content-footer-with-actions-height: 168px;
    private property <length> detail-action-step: 104px;
    private property <length> detail-action-width: 96px;
    private property <length> detail-action-height: 28px;
    private property <length> detail-action-bottom: 78px;
    private property <length> detail-source-bottom: 42px;
    private property <color> detail-surface: root.dark-mode ? DesignTokens.dark-surface : DesignTokens.light-surface;
    private property <color> detail-raised-surface: root.dark-mode ? DesignTokens.dark-raised : DesignTokens.light-raised;
    private property <color> detail-code-surface: root.dark-mode ? DesignTokens.dark-canvas : DesignTokens.light-raised;
    private property <int> total-section-headers: root.results.length == 0 ? 0 : root.results[root.results.length - 1].headers_before + (root.results[root.results.length - 1].section_kind != "" ? 1 : 0);
    private property <int> first-visible-index: max(0, round((-results-list.content-y - root.total-section-headers * root.section-header-height) / root.result-row-height) - 2);
    private property <bool> context-click-consumed: false;
    private property <int> last-visible-index: min(root.results.length, round((-results-list.content-y + results-list.visible-height) / root.result-row-height) + 1);
    private property <color> canvas: root.dark-mode ? DesignTokens.dark-canvas : DesignTokens.light-canvas;
    private property <color> surface-hover: root.dark-mode ? DesignTokens.dark-raised : DesignTokens.light-raised;
    private property <color> surface-selected: root.accent-background;
    private property <color> border: root.dark-mode ? DesignTokens.dark-border : DesignTokens.light-border;
    private property <color> text-primary: root.dark-mode ? DesignTokens.dark-primary : DesignTokens.light-primary;
    private property <color> text-secondary: root.dark-mode ? DesignTokens.dark-secondary : DesignTokens.light-secondary;
    private property <color> text-tertiary: root.dark-mode ? DesignTokens.dark-tertiary : DesignTokens.light-tertiary;
    private property <color> accent: root.accent-color;

    public function ensure-selected-visible() {
        if (root.selected-index < 0 || root.selected-index >= root.results.length) { return; }
        let row-data = root.results[root.selected-index];
        let row-top = root.selected-index * root.result-row-height + row-data.headers_before * root.section-header-height;
        let row-bottom = row-top + (row-data.section_kind != "" ? root.section-header-height : 0px) + root.result-row-height;
        if (row-top + results-list.content-y < 0px) {
            results-list.content-y = min(0px, max(results-list.visible-height - results-list.content-height, -row-top));
        }
        if (row-bottom + results-list.content-y > results-list.visible-height) {
            results-list.content-y = min(0px, max(results-list.visible-height - results-list.content-height, results-list.visible-height - row-bottom));
        }
    }

    public function reset-result-scroll() {
        results-list.content-y = 0px;
    }

    function move-selection-down() {
        if (root.compact-search && root.root-query-empty && !root.shortcut-session-active && !root.empty-query-results-visible) {
            root.empty-query-results-visible = true;
            root.compact-results-requested();
        }
        if (root.results.length == 0) { return; }
        root.selected-index = min(root.selected-index + 1, root.results.length - 1);
    }

    function move-selection-up() {
        if (root.results.length == 0) { return; }
        root.selected-index = max(root.selected-index - 1, 0);
    }

    function result-section-title(kind: string) -> string {
        return kind == "best_match" ? @tr("Best match")
            : kind == "favorites" ? @tr("Favorites")
            : kind == "command" ? @tr("Command")
            : kind == "suggestions" ? @tr("Suggestions")
            : kind == "fallbacks" ? @tr("Other results")
            : kind == "application" ? @tr("Application")
            : kind == "game" ? @tr("Game")
            : kind == "website" ? @tr("Website")
            : kind == "bookmark" ? @tr("Bookmark")
            : kind == "window" ? @tr("Window")
            : kind == "calculator" ? @tr("Calculator")
            : kind == "control_panel" ? @tr("Control Panel")
            : kind == "settings" ? @tr("Settings")
            : kind == "document" ? @tr("Document")
            : @tr("Other");
    }

    changed selected-index => {
        root.ensure-selected-visible();
        root.selection-changed(root.selected-index);
    }
    changed category-filters => {
        if (root.category-filters.length == 0 && root.category-filter-keyboard-active) {
            search-field.focus();
        }
    }
    changed first-visible-index => { root.visible-range-changed(root.first-visible-index, root.last-visible-index); }
    changed last-visible-index => { root.visible-range-changed(root.first-visible-index, root.last-visible-index); }
    changed detail-panel-active => {
        if (!root.detail-panel-active) {
            search-field.focus();
        }
    }
    // The host coalesces range notifications on the next event-loop turn, so
    // layout and selection changes cannot synchronously rebuild the result model.
    changed available-results-height => { root.visible-range-changed(root.first-visible-index, root.last-visible-index); }

    Rectangle {
        x: root.window-inset; y: root.window-inset;
        width: parent.width - 2 * root.window-inset;
        height: parent.height - 2 * root.window-inset;
        background: root.canvas;
        border-color: root.border;
        border-width: root.native-window-frame ? 0px : 1px;
        // Windows rounds the native frame, including its shadow.
        border-radius: root.native-window-frame ? 0px : DesignTokens.radius-lg;

        VerticalBox {
            padding: root.content-padding;
            padding-top: root.empty-state-padding;
            padding-bottom: root.compact-results-hidden ? root.empty-state-padding : root.content-bottom-padding;
            spacing: root.category-layout-spacing;

            Rectangle {
                z: 0;
                height: root.search-row-layout-height;
                background: transparent;

                back-button := Rectangle {
                    x: root.shortcut-session-active ? 0px : -root.session-back-width;
                    y: 0px; width: root.session-back-width; height: parent.height;
                    opacity: root.shortcut-session-active ? 1.0 : 0.0;
                    clip: true;
                    back-hit := TouchArea {
                        width: parent.width; height: parent.height;
                        clicked => { root.search-back-requested(); }
                    }
                    Rectangle {
                        x: 0px; y: max(0px, (parent.height - 28px) / 2); width: root.session-back-width; height: min(parent.height, 28px);
                        border-radius: DesignTokens.radius-md;
                        background: root.shortcut-session-active && back-hit.has-hover ? root.surface-hover : transparent;
                        BuiltinIcon { x: 5px; y: (parent.height - 12px) / 2; width: 12px; height: 12px; kind: root.dark-mode ? "arrow-left-light" : "arrow-left-dark"; }
                    }
                }
                SearchGlyph {
                    x: root.search-icon-x; y: (root.search-row-layout-height - root.result-icon-size) / 2;
                    width: root.result-icon-size; height: root.result-icon-size;
                    source-image: root.search-icon; source-kind: root.search-icon-kind;
                    previous-image: root.search-icon-previous;
                    previous-kind: root.search-icon-previous-kind;
                    transition-progress: root.search-icon-transition-progress;
                    transition-animation-enabled: root.search-icon-animation-enabled;
                    animations-enabled: root.animations-enabled;
                }
                Rectangle {
                    x: root.search-input-x; y: 0px; width: parent.width - root.search-input-x - 10px; height: root.search-row-layout-height;
                    background: transparent;
                    clip: true;
                    Text {
                        x: root.search-input-scroll-x; y: 0px; width: parent.width - root.search-input-scroll-x; height: parent.height;
                        text: root.shortcut-session-active ? root.shortcut-session-placeholder : @tr("Search apps, files, settings, and more");
                        color: root.text-tertiary; font-size: DesignTokens.font-input; vertical-alignment: center;
                        visible: search-field.text == "";
                    }
                    search-field := TextInput {
                        x: root.search-input-scroll-x; y: 0px; width: max(parent.width, self.preferred-width); height: parent.height;
                        color: root.text-primary; font-size: DesignTokens.font-input; vertical-alignment: center; horizontal-alignment: left; single-line: true;
                        selection-background-color: root.accent-color;
                        selection-foreground-color: #ffffff;
                        text <=> root.query-text;
                        cursor-position-changed(cursor-position) => {
                            let margin = 6px;
                            if (cursor-position.x + root.search-input-scroll-x < margin) {
                                root.search-input-scroll-x = margin - cursor-position.x;
                            } else if (cursor-position.x + root.search-input-scroll-x > parent.width - margin - self.text-cursor-width) {
                                root.search-input-scroll-x = parent.width - margin - cursor-position.x - self.text-cursor-width;
                            }
                        }
                        edited => {
                            let normalized = root.normalize-query(self.text);
                            if (normalized != self.text) {
                                self.text = normalized;
                            }
                            root.query-results-ready = false;
                            root.query-changed(self.text);
                        }
                        key-pressed(event) => {
                            if (event.text == Key.DownArrow) {
                                root.move-selection-down();
                                EventResult.accept
                            } else if (event.text == Key.UpArrow) {
                                root.move-selection-up();
                                EventResult.accept
                            } else if ((event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) || (event.text == "m" && event.modifiers.control)) && root.selected-index >= 0) {
                                root.context-menu-requested(root.selected-index, true);
                                EventResult.accept
                            // A visible row, including a persisted session-history
                            // row, is the user's explicit choice. Only fall back
                            // to executing the raw input when no row is selected.
                            } else if (event.text == Key.Return && root.selected-index >= 0) {
                                root.launch-requested(root.selected-index);
                                EventResult.accept
                            } else if (event.text == Key.Return && root.shortcut-session-execute-mode) {
                                root.session-execute-requested();
                                EventResult.accept
                            } else if (event.text == Key.Return && root.selected-index < 0 && root.empty-state-title != "") {
                                root.empty-state-activated();
                                EventResult.accept
                            } else if (event.text == Key.Escape) {
                                if (root.detail-visible) {
                                    root.detail-back-requested();
                                } else if (root.shortcut-session-active) {
                                    root.shortcut-back-requested();
                                } else {
                                    root.dismiss-requested();
                                }
                                EventResult.accept
                            } else {
                                EventResult.reject
                            }
                        }
                    }
                }
            }

            if (root.category-filters.length > 0 && !root.compact-results-hidden) : Rectangle {
                height: root.category-filter-height;
                background: transparent;
                // Keep category arrow navigation scoped so the search field's
                // caret and result navigation retain their existing keys.
                category-filter-focus := FocusScope {
                    width: parent.width;
                    height: parent.height;
                    filters: root.category-filters;
                    selected-index: root.selected-category-index;
                    in property <[CategoryFilter]> filters;
                    in property <int> selected-index;
                    focus-on-tab-navigation: true;
                    focus-on-click: false;
                    focus-gained => { root.category-filter-keyboard-active = true; }
                    focus-lost => {
                        root.category-filter-keyboard-active = false;
                        if (root.category-filters.length == 0 || root.compact-results-hidden) {
                            search-field.focus();
                        }
                    }
                    changed filters => { self.ensure-selected-category-visible(); }
                    changed selected-index => { self.ensure-selected-category-visible(); }
                    function select-category-at(index: int) {
                        if (index < 0 || index >= self.filters.length) { return; }
                        root.category-filter-selected(self.filters[index].key);
                        self.ensure-selected-category-visible();
                    }
                    function move-category-selection(delta: int) {
                        if (self.filters.length == 0) { return; }
                        let next = min(max(self.selected-index + delta, 0), self.filters.length - 1);
                        self.select-category-at(next);
                    }
                    function ensure-selected-category-visible() {
                        if (self.filters.length == 0 || root.compact-results-hidden) { return; }
                        let left = self.selected-index * root.category-filter-step;
                        let right = left + root.category-button-width;
                        let visible-left = -category-flickable.content-x;
                        let visible-right = visible-left + category-flickable.width;
                        if (left < visible-left) {
                            category-flickable.content-x = min(0px, max(category-flickable.width - category-flickable.content-width, -left));
                        } else if (right > visible-right) {
                            category-flickable.content-x = min(0px, max(category-flickable.width - category-flickable.content-width, category-flickable.width - right));
                        }
                    }
                    key-pressed(event) => {
                        let plain-key = !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta;
                        if (plain-key && event.text == Key.LeftArrow) {
                            self.move-category-selection(-1);
                            accept
                        } else if (plain-key && event.text == Key.RightArrow) {
                            self.move-category-selection(1);
                            accept
                        } else if (plain-key && event.text == Key.Home) {
                            self.select-category-at(0);
                            accept
                        } else if (plain-key && event.text == Key.End) {
                            self.select-category-at(self.filters.length - 1);
                            accept
                        } else if (plain-key && (event.text == Key.Return || event.text == Key.Space)) {
                            self.select-category-at(self.selected-index);
                            search-field.focus();
                            accept
                        } else if (plain-key && (event.text == Key.UpArrow || event.text == Key.DownArrow)) {
                            search-field.focus();
                            if (event.text == Key.DownArrow) {
                                root.move-selection-down();
                            } else {
                                root.move-selection-up();
                            }
                            accept
                        } else if (plain-key && event.text == Key.Escape) {
                            search-field.focus();
                            accept
                        } else {
                            reject
                        }
                    }
                    category-flickable := Flickable {
                        width: parent.width;
                        height: parent.height;
                        content-width: max(self.width, category-filter-focus.filters.length * root.category-filter-step);
                        content-height: self.height;
                        Rectangle {
                            x: root.selected-category-index * root.category-filter-step;
                            y: (parent.height - root.category-button-height) / 2;
                            width: root.category-button-width;
                            height: root.category-button-height;
                            border-radius: DesignTokens.radius-md;
                            background: root.surface-hover;
                        }
                        for filter[index] in category-filter-focus.filters : Rectangle {
                            x: index * root.category-filter-step;
                            y: 0px;
                            width: root.category-button-width;
                            height: parent.height;
                            border-radius: DesignTokens.radius-md;
                            background: transparent;
                            Rectangle {
                                x: 0px;
                                y: (parent.height - root.category-button-height) / 2;
                                width: parent.width;
                                height: root.category-button-height;
                                border-radius: DesignTokens.radius-md;
                                border-color: root.selected-category-filter == filter.key
                                    ? (root.category-filter-keyboard-active ? (root.dark-mode ? DesignTokens.dark-focus : DesignTokens.light-focus) : transparent)
                                    : root.border;
                                border-width: root.selected-category-filter == filter.key
                                    ? (root.category-filter-keyboard-active ? 2px : 0px)
                                    : 1px;
                                background: root.selected-category-filter != filter.key && filter-touch.has-hover ? root.surface-hover : transparent;
                            }
                            filter-touch := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                mouse-cursor: pointer;
                                clicked => { root.category-filter-selected(filter.key); search-field.focus(); }
                                scroll-event(event) => {
                                    let delta = event.delta-x != 0px ? event.delta-x : event.delta-y;
                                    let previous = category-flickable.content-x;
                                    let next = min(0px, max(category-flickable.width - category-flickable.content-width, previous - delta));
                                    if (next != previous) {
                                        category-flickable.content-x = next;
                                        EventResult.accept
                                    } else {
                                        EventResult.reject
                                    }
                                }
                            }
                            Text {
                                x: 6px; width: parent.width - 12px; height: parent.height;
                                text: (filter.key == "all" ? @tr("All") : filter.key == "application" ? @tr("Application") : filter.key == "game" ? @tr("Game") : filter.key == "website" ? @tr("Website") : filter.key == "calculator" ? @tr("Calculator") : filter.key == "control_panel" ? @tr("Control Panel") : filter.key == "settings" ? @tr("Settings") : filter.key == "document" ? @tr("Document") : filter.key == "bookmark" ? @tr("Bookmark") : filter.key == "window" ? @tr("Window") : filter.key == "command" ? @tr("Command") : @tr("Other")) + "  " + filter.count;
                                color: root.selected-category-filter == filter.key ? root.text-primary : root.text-secondary;
                                font-size: DesignTokens.font-small;
                                font-weight: root.selected-category-filter == filter.key ? DesignTokens.weight-semibold : DesignTokens.weight-regular;
                                horizontal-alignment: center; vertical-alignment: center; overflow: elide;
                            }
                        }
                    }
                }
            }

            results-area := Rectangle {
                height: root.available-results-height;
                background: transparent;
                clip: true;

                results-list := ScrollView {
                    visible: !root.compact-results-hidden;
                    x: 0px; y: 0px;
                    width: parent.width - (root.detail-visible ? parent.width * root.detail-panel-share + root.result-column-gap - root.detail-panel-alignment-shift : 0px);
                    // Position the bounded visible slice using exact prefix geometry.
                    // ListView estimates off-screen variable row heights, which shifts
                    // grouped rows away from ensure-selected-visible's coordinates.
                    content-height: root.results.length * root.result-row-height + root.total-section-headers * root.section-header-height;
                    content-width: self.visible-width;
                    height: parent.height;
                for offset in max(0, root.last-visible-index - root.first-visible-index) : result-row := Rectangle {
                    private property <int> index: root.first-visible-index + offset;
                    private property <ResultRow> row-data: root.results[index];
                    x: root.result-row-inset;
                    y: index * root.result-row-height + row-data.headers_before * root.section-header-height;
                    width: results-list.visible-width - 2 * root.result-row-inset;
                    height: root.result-row-height + (row-data.section_kind != "" ? root.section-header-height : 0px);
                    background: transparent;

                    if row-data.section_kind != "" : Rectangle {
                        x: 0px; y: 0px;
                        width: parent.width;
                        height: root.section-header-height;
                        background: transparent;
                        Rectangle {
                            x: 8px; y: 0px; width: parent.width - 16px; height: 1px;
                            background: root.border; opacity: 0.55;
                            visible: index > 0;
                        }
                        Text {
                            x: 8px; y: 1px;
                            width: parent.width - (row-data.section_more_key != "" ? 106px : 16px);
                            height: parent.height - 1px;
                            text: root.result-section-title(row-data.section_kind) + (row-data.section_kind == "best_match" ? "" : "  " + row-data.section_count);
                            color: root.text-secondary;
                            font-size: DesignTokens.font-small;
                            font-weight: DesignTokens.weight-semibold;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if row-data.section_more_key != "" : Text {
                            x: parent.width - 94px; y: 1px; width: 86px; height: parent.height - 1px;
                            text: @tr("See more"); color: root.accent;
                            font-size: DesignTokens.font-small; horizontal-alignment: right; vertical-alignment: center;
                            overflow: elide;
                        }
                        if row-data.section_more_key != "" : TouchArea {
                            x: parent.width - 100px; y: 0px; width: 100px; height: parent.height;
                            mouse-cursor: pointer;
                            enabled: root.query-results-ready;
                            clicked => {
                                root.category-filter-selected(row-data.section_more_key);
                                search-field.focus();
                            }
                        }
                    }

                    Rectangle {
                        x: 0px;
                        y: row-data.section_kind != "" ? root.section-header-height : 0px;
                        width: parent.width;
                        height: root.result-row-height;
                        private property <length> shortcut-card-width: row-data.shortcut_prefix_width * 1px;
                        private property <length> row-icon-size: row-data.presentation == "compact" ? 20px : row-data.is_best_match ? root.result-icon-size + 4px : root.result-icon-size;
                        private property <length> row-title-height: row-data.presentation == "compact" ? 16px : max(18px, root.ui-font-size * 1.2);
                        private property <length> row-description-height: row-data.presentation == "compact" ? 14px : max(16px, root.ui-font-size);
                        private property <length> row-text-gap: 0px;
                        private property <length> row-text-height: row-title-height + row-text-gap + row-description-height;
                        private property <length> row-text-top: max(0px, (root.result-row-height - row-text-height) / 2);
                        background: index == root.selected-index ? root.surface-selected : item-area.has-hover ? root.surface-hover : transparent;
                        border-color: transparent;
                        border-width: 0px;
                        border-radius: DesignTokens.radius-md;
                        item-area := TouchArea {
                            clicked => {
                                if (root.context-click-consumed) {
                                    root.context-click-consumed = false;
                                } else {
                                    if (root.query-results-ready) { root.launch-requested(index); }
                                }
                            }
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.right) {
