                                } else {
                                    EventResult.reject
                                }
                            }
                        }
                        BuiltinIcon { visible: row-data.icon_kind != ""; x: 18px; y: (root.result-row-height - row-icon-size) / 2; width: row-icon-size; height: row-icon-size; kind: row-data.icon_kind; }
                        if row-data.icon_kind == "" : Image { x: 18px; y: (root.result-row-height - row-icon-size) / 2; width: row-icon-size; height: row-icon-size; source: row-data.icon; image-fit: contain; }
                    Rectangle {
                        x: 60px; y: 0px; width: row-data.shortcut_prefix == "" || root.detail-visible ? parent.width - 76px - (row-data.favorite ? 22px : 0px) : parent.width - 60px - parent.shortcut-card-width - (row-data.favorite ? 40px : 0px); height: parent.height; background: transparent;
                        Text { x: 0px; y: row-text-top; width: parent.width; height: row-title-height; text: row-data.id == root.last-action-id && root.last-action-result != "" ? root.last-action-result : row-data.title; color: root.text-primary; font-size: row-data.presentation == "compact" ? DesignTokens.font-body : DesignTokens.font-base; font-weight: row-data.is_best_match ? DesignTokens.weight-bold : DesignTokens.weight-medium; vertical-alignment: center; overflow: elide; }
                        Text { x: 0px; y: row-text-top + row-title-height + row-text-gap; width: parent.width - 4px; height: row-description-height; text: row-data.id == root.last-action-id && root.last-action-subtitle != "" ? root.last-action-subtitle : row-data.location_kind == "control-panel" ? @tr("Control Panel") : row-data.location_kind == "application" && row-data.location == "" ? @tr("Application") : row-data.location; color: root.text-secondary; font-size: row-data.presentation == "compact" ? DesignTokens.font-caption : DesignTokens.font-small; vertical-alignment: center; overflow: elide; }
                    }
                    Rectangle {
                        x: parent.width - shortcut-card-width - 10px; y: (root.result-row-height - 24px) / 2; width: shortcut-card-width; height: 24px;
                        background: root.detail-raised-surface;
                        border-color: root.border; border-width: 1px; border-radius: DesignTokens.radius-sm;
                        visible: row-data.shortcut_prefix != "" && !root.detail-visible;
                        Text { width: parent.width - 8px; height: parent.height; x: 4px; text: row-data.shortcut_prefix; color: root.text-secondary; font-size: DesignTokens.font-small; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    }
                    if row-data.favorite : BuiltinIcon {
                        x: row-data.shortcut_prefix == "" || root.detail-visible ? parent.width - 26px : parent.width - shortcut-card-width - 32px;
                        y: (root.result-row-height - 16px) / 2;
                        width: 16px; height: 16px; kind: "star";
                    }
                }
                }
                }

                detail-panel := Rectangle {
                    private property <length> panel-width: root.detail-panel-width;
                    private property <length> panel-height: max(0px, parent.height - root.detail-panel-bottom-inset);
                    visible: root.detail-panel-active;
                    x: results-list.width + root.result-column-gap - root.result-row-inset;
                    y: 0px;
                    width: self.panel-width;
                    height: self.panel-height;
                    background: root.detail-surface;
                    border-color: root.border;
                    border-width: 1px;
                    border-radius: DesignTokens.radius-md;
                    clip: true;

                Flickable {
                        x: parent.width - detail-panel.panel-width;
                        width: detail-panel.panel-width;
                        height: detail-panel.panel-height;
                        content-width: self.width;
                        content-height: max(self.height, root.detail-panel-content-height);
                        interactive: root.detail-panel-scrollable || root.detail-panel-content-height > self.height;

                        Rectangle {
                            width: parent.width;
                            height: max(parent.height, root.detail-panel-content-height);
                            background: transparent;

                            Text { x: root.detail-content-inset; y: root.detail-header-top; width: parent.width - 2 * root.detail-content-inset; height: 24px; text: root.detail-title; color: root.text-primary; font-size: DesignTokens.font-heading; font-weight: DesignTokens.weight-semibold; overflow: elide; }
                    Text { x: root.detail-content-inset; y: root.detail-subtitle-top; width: parent.width - 2 * root.detail-content-inset; height: 18px; text: root.detail-subtitle; color: root.text-secondary; font-size: DesignTokens.font-small; overflow: elide; }
                    VerticalBox {
                        x: root.detail-content-inset; y: root.detail-content-top; width: parent.width - 2 * root.detail-content-inset; height: parent.height - (root.detail-actions.length > 0 ? root.detail-content-footer-with-actions-height : root.detail-content-footer-height); spacing: root.detail-block-spacing;
                        for block in root.detail-blocks : Rectangle {
                            height: block.height * 1px;
                            background: transparent;
                            if (block.kind == "text" || block.kind == "text-copyable") : Rectangle {
                                width: parent.width; height: parent.height;
                                if (block.kind == "text-copyable") : TextInput { width: parent.width; height: parent.height; text: block.value; color: block.color == "primary" ? root.text-primary : block.color == "accent" ? root.accent : root.text-secondary; font-size: DesignTokens.font-body; vertical-alignment: top; single-line: false; wrap: word-wrap; read-only: true; selection-background-color: root.accent-color; selection-foreground-color: #ffffff; }
                                if (block.kind == "text") : Text { width: parent.width; height: parent.height; text: block.value; color: block.color == "primary" ? root.text-primary : block.color == "accent" ? root.accent : root.text-secondary; font-size: DesignTokens.font-body; vertical-alignment: top; wrap: word-wrap; overflow: clip; }
                            }
                            if (block.kind == "markdown" || block.kind == "markdown-copyable") : Rectangle {
                                width: parent.width; height: parent.height;
                                if (block.kind == "markdown-copyable") : TextInput { width: parent.width; height: parent.height; text: block.value; color: block.color == "primary" ? root.text-primary : block.color == "accent" ? root.accent : root.text-secondary; font-size: DesignTokens.font-body; vertical-alignment: top; single-line: false; wrap: word-wrap; read-only: true; selection-background-color: root.accent-color; selection-foreground-color: #ffffff; }
                                if (block.kind == "markdown") : Text { width: parent.width; height: parent.height; text: block.value; color: block.color == "primary" ? root.text-primary : block.color == "accent" ? root.accent : root.text-secondary; font-size: DesignTokens.font-body; vertical-alignment: top; wrap: word-wrap; overflow: clip; }
                            }
                            if (block.kind == "metric") : Rectangle {
                                width: parent.width; height: parent.height; background: root.detail-raised-surface; border-radius: DesignTokens.radius-md;
                                Text { x: 10px; y: 8px; width: parent.width - 20px; height: 14px; text: block.label; color: root.text-tertiary; font-size: DesignTokens.font-caption; }
                                Text { x: 10px; y: 26px; width: parent.width - 20px; height: 18px; text: block.value; color: block.color == "accent" ? root.accent : root.text-primary; font-size: DesignTokens.font-body; font-weight: DesignTokens.weight-semibold; overflow: elide; }
                            }
                            if (block.kind == "icon") : Image { width: parent.width; height: parent.height; source: block.icon; image-fit: contain; visible: block.icon.width > 0; }
                            if (block.kind == "icon") : Text { width: parent.width; height: parent.height; text: block.value; color: block.color == "accent" ? root.accent : root.text-primary; font-size: 2.2857rem; horizontal-alignment: center; vertical-alignment: center; visible: block.icon.width == 0; }
                            if (block.kind == "image") : Rectangle {
                                width: parent.width; height: parent.height; background: root.detail-raised-surface; border-radius: DesignTokens.radius-md;
                                Image { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px; source: block.icon; image-fit: contain; visible: block.icon.width > 0; }
                                Text { width: parent.width; height: parent.height; text: block.secondary == "" ? @tr("Preview unavailable") : block.secondary; color: root.text-secondary; horizontal-alignment: center; vertical-alignment: center; visible: block.icon.width == 0; overflow: elide; }
                            }
                            if (block.kind == "code") : Rectangle {
                                width: parent.width; height: parent.height; background: root.detail-code-surface; border-radius: DesignTokens.radius-md;
                                Text { x: 10px; y: 6px; width: parent.width - 20px; height: 14px; text: block.label; color: root.text-tertiary; font-size: DesignTokens.font-caption; visible: block.label != ""; }
                                Text { x: 10px; y: block.label == "" ? 8px : 24px; width: parent.width - 20px; height: parent.height - (block.label == "" ? 16px : 30px); text: block.value; color: root.text-primary; font-size: DesignTokens.font-small; overflow: clip; }
                            }
                            if (block.kind == "table") : Rectangle {
                                width: parent.width; height: parent.height; background: root.detail-raised-surface; border-radius: DesignTokens.radius-md;
                                Text { x: 10px; y: 6px; width: parent.width - 20px; height: 16px; text: block.label; color: root.text-secondary; font-size: DesignTokens.font-caption; overflow: elide; }
                                Text { x: 10px; y: 24px; width: parent.width - 20px; height: parent.height - 30px; text: block.value; color: root.text-primary; font-size: DesignTokens.font-small; overflow: clip; }
                            }
                            if (block.kind == "link") : Rectangle {
                                width: parent.width; height: parent.height; background: transparent;
                                Text { width: parent.width; height: parent.height; text: block.label + "  " + block.value; color: root.accent; font-size: DesignTokens.font-label; vertical-alignment: center; overflow: elide; }
                                TouchArea { clicked => { root.detail-link-requested(block.value); } }
                            }
                            if (block.kind == "loading") : Text {
                                width: parent.width; height: parent.height; text: "⏳  " + block.value; color: root.text-secondary; font-size: DesignTokens.font-label; vertical-alignment: center; overflow: elide;
                            }
                            if (block.kind == "error") : Text {
                                width: parent.width; height: parent.height; text: "⚠  " + block.value; color: #d96c6c; font-size: DesignTokens.font-label; vertical-alignment: center; overflow: elide;
                            }
                            if (block.kind == "separator") : Rectangle { y: 0px; width: parent.width; height: 1px; background: transparent; }
                            if (block.kind == "weather") : Text {
                                width: parent.width; height: parent.height;
                                text: block.value == "clear" ? "☀" : block.value == "snow" ? "❄" : block.value == "storm" ? "⚡" : block.value == "rain" ? "☂" : "☁";
                                color: block.value == "clear" ? #ffc144 : block.value == "storm" ? #ffd34e : block.value == "rain" ? #4da3e6 : #b8c5d4;
                                font-size: 2.7143rem; horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                    for action[index] in root.detail-actions : Rectangle {
                        x: root.detail-content-inset + index * root.detail-action-step; y: parent.height - root.detail-action-bottom; width: root.detail-action-width; height: root.detail-action-height;
                        background: action-area.has-hover ? root.surface-hover : root.detail-raised-surface;
                        border-color: root.border; border-width: 1px; border-radius: DesignTokens.radius-md;
                        action-area := TouchArea { clicked => { root.detail-action-requested(index); } }
                        BuiltinIcon { x: 8px; y: 6px; width: 16px; height: 16px; kind: action.icon_kind; }
                        if action.icon_kind == "" : Image { x: 8px; y: 6px; width: 16px; height: 16px; source: action.icon; image-fit: contain; }
                        Text { x: 28px; y: 0px; width: parent.width - 36px; height: parent.height; text: action.title; color: root.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    }
                    Text { x: root.detail-content-inset; y: parent.height - root.detail-source-bottom; width: parent.width - 2 * root.detail-content-inset; height: 18px; text: root.detail-source; color: root.text-tertiary; font-size: DesignTokens.font-caption; overflow: elide; }
                        }
                    }
                }
                if (root.results.length == 0 && (search-field.text != "" || root.shortcut-session-active) && root.query-results-ready && !root.detail-visible) : Rectangle {
                    x: 0px;
                    y: max(0px, (parent.height - root.no-results-height) / 2);
                    width: parent.width; height: root.no-results-height; background: transparent;
                    TouchArea { clicked => { if (root.empty-state-title != "") { root.empty-state-activated(); } } }
                    if root.empty-state-icon-kind != "" : BuiltinIcon { x: (parent.width - 44px) / 2; y: 0px; width: 44px; height: 44px; kind: root.empty-state-icon-kind; }
                    if root.empty-state-icon-kind == "" && root.empty-state-icon.width > 0 : Image { x: (parent.width - 44px) / 2; y: 0px; width: 44px; height: 44px; source: root.empty-state-icon; image-fit: contain; }
                    if root.empty-state-icon-kind == "" && root.empty-state-icon.width == 0 : BuiltinIcon { x: (parent.width - 36px) / 2; y: 4px; width: 36px; height: 36px; kind: "magnify"; }
                    Text { x: 24px; y: 52px; width: parent.width - 48px; height: 40px; text: root.empty-state-title != "" ? root.empty-state-title : @tr("No results"); color: root.text-secondary; font-size: DesignTokens.font-title; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; overflow: clip; }
                    if root.empty-state-description != "" : Text { x: 24px; y: 98px; width: parent.width - 48px; height: 58px; text: root.empty-state-description; color: root.text-tertiary; font-size: DesignTokens.font-label; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; overflow: clip; }
                }
            }

            if (!root.compact-results-hidden) : Rectangle {
                height: root.operation-hint-height; background: transparent;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: root.border; }
                Rectangle {
                    width: parent.width; height: parent.height - 1px; background: transparent;
                    if root.search-feedback-visible || root.pagination-feedback-visible : Rectangle {
                        x: DesignTokens.space-2; y: 0px; width: parent.width - 2 * DesignTokens.space-2; height: parent.height - 1px;
                        background: transparent;
                        Rectangle { x: 0px; y: (parent.height - 6px) / 2; width: 6px; height: 6px; background: root.accent-color; border-radius: 3px; }
                        Text { x: 12px; width: parent.width - 12px; height: parent.height; text: root.pagination-feedback-visible ? @tr("Loading more...") : @tr("Searching..."); color: root.text-secondary; font-size: DesignTokens.font-small; vertical-alignment: center; overflow: elide; }
                    }
                    if !root.search-feedback-visible && !root.pagination-feedback-visible : Text {
                        width: parent.width; height: parent.height;
                        text: root.category-filter-keyboard-active ? @tr("← → Filter     ↑ ↓ Results     Home/End First/Last     Enter/Space/Esc Search") : root.context-menu-available ? (root.shortcut-session-active ? @tr("↑ ↓  Navigate     Tab Filter     Enter  Open     Ctrl+M  Context     Esc  Back") : @tr("↑ ↓  Navigate     Tab Filter     Enter  Open     Ctrl+M  Context     Esc  Hide")) : (root.shortcut-session-active ? @tr("↑ ↓  Navigate     Tab Filter     Enter  Open     Esc  Back") : @tr("↑ ↓  Navigate     Tab Filter     Enter  Open     Esc  Hide"));
                        color: root.text-tertiary; font-size: DesignTokens.font-small; horizontal-alignment: center; vertical-alignment: center;
                    }
                }
            }
        }
        if (!root.compact-results-hidden) : Rectangle {
            x: root.content-padding;
            y: root.empty-state-padding + root.search-row-layout-height + (root.category-filters.length > 0 ? root.category-layout-spacing / 2 : root.content-spacing / 2) - 0.5px;
            width: parent.width - 2 * root.content-padding;
            height: 1px;
            background: root.border;
        }
    }
    if (root.launch-error != "") : Rectangle {
        x: 18px; y: parent.height - 38px; width: parent.width - 36px; height: 26px;
        background: root.dark-mode ? #3b2525 : #fff0f0;
        border-color: #b85c5c; border-width: 1px; border-radius: DesignTokens.radius-sm;
        Text { x: 8px; y: 0px; width: parent.width - 16px; height: parent.height; text: @tr("Could not open application") + ": " + root.launch-error; color: #d96c6c; font-size: DesignTokens.font-small; vertical-alignment: center; overflow: elide; }
    }

    if root.context-menu-open : Rectangle {
        width: root.width; height: root.height;
        background: transparent;
        TouchArea {
            pointer-event(event) => {
                // Remove the old overlay on press so the underlying result
                // receives the release and opens its menu at the new point.
                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) { root.context-menu-dismissed(); }
            }
            scroll-event => { accept }
            clicked => { root.context-menu-dismissed(); }
        }
        ContextMenu {
            width: root.context-menu-effective-width;
            height: root.context-menu-effective-height;
            x: root.context-menu-x;
            y: root.context-menu-y;
            actions: root.context-actions;
            keyboard-invoked: root.context-keyboard-invoked;
            dark-mode: root.dark-mode;
            action-requested(id) => { root.context-action-requested(id); }
            dismissed => { root.context-menu-dismissed(); }
        }
    }
}
