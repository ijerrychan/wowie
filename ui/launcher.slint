import { VerticalBox, ListView } from "std-widgets.slint";

export struct ResultRow { id: string, title: string, location: string, location_kind: string, icon: image, icon_kind: string, shortcut_prefix: string, shortcut_prefix_width: int, presentation: string }
export struct ContextActionRow { id: string, title: string, subtitle: string, kind: string, icon: image, icon_kind: string, shortcut: string }
export struct DetailBlock { kind: string, label: string, value: string, color: string, secondary: string, icon: image }

component BuiltinIcon inherits Image {
    in property <string> kind;
    visible: root.kind != "";
    image-fit: contain;
    source: root.kind == "weather" ? @image-url("../assets/icons/weather.svg")
        : root.kind == "calculator" ? @image-url("../assets/icons/calculator.svg")
        : root.kind == "book" ? @image-url("../assets/icons/book-open.svg")
        : root.kind == "checklist" ? @image-url("../assets/icons/list-checks.svg")
        : root.kind == "folder-open" ? @image-url("../assets/icons/folder-open-outline.svg")
        : root.kind == "shield-account" ? @image-url("../assets/icons/shield-account-outline.svg")
        : @image-url("../wowie.png");
}

component SearchGlyph inherits Rectangle {
    in property <image> source-image;
    in property <string> source-kind;
    in property <image> previous-image;
    in property <string> previous-kind;
    in property <float> transition-progress: 1.0;
    in property <bool> transition-animation-enabled: true;
    background: transparent;
    clip: true;

    private property <float> animated-progress: root.transition-progress;
    private property <float> outgoing-scale: max(0.0, 1.0 - root.animated-progress);
    private property <float> incoming-scale: 0.72 + root.animated-progress * 0.28;
    animate animated-progress {
        duration: 180ms;
        easing: ease-out-back;
        enabled: root.transition-animation-enabled;
    }

    Rectangle {
        x: (parent.width - parent.width * root.outgoing-scale) / 2;
        y: (parent.height - parent.height * root.outgoing-scale) / 2;
        width: parent.width * root.outgoing-scale;
        height: parent.height * root.outgoing-scale;
        background: transparent;
        BuiltinIcon {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            kind: root.previous-kind;
            opacity: max(0.0, 1.0 - root.animated-progress);
        }
        if root.previous-kind == "" : Image {
            width: parent.width; height: parent.height;
            source: root.previous-image.width > 0 ? root.previous-image : @image-url("../assets/icons/magnify.svg");
            image-fit: contain;
            opacity: max(0.0, 1.0 - root.animated-progress);
        }
    }

    Rectangle {
        x: (parent.width - parent.width * root.incoming-scale) / 2;
        y: (parent.height - parent.height * root.incoming-scale) / 2;
        width: parent.width * root.incoming-scale;
        height: parent.height * root.incoming-scale;
        background: transparent;
        BuiltinIcon {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            kind: root.source-kind;
            opacity: min(1.0, root.animated-progress);
        }
        if root.source-kind == "" : Image {
            width: parent.width; height: parent.height;
            source: root.source-image.width > 0 ? root.source-image : @image-url("../assets/icons/magnify.svg");
            image-fit: contain;
            opacity: min(1.0, root.animated-progress);
        }
    }
}

export component Launcher inherits Window {
    title: "Wowie";
    no-frame: true;
    // Let the winit backend expose native resize cursors and edge/corner
    // dragging for this frameless launcher.
    resize-border-width: 8px;
    preferred-width: window-width * 1px;
    min-width: 520px;
    // With details open, both columns contribute to the window's required
    // height. Using only the detail card here clipped long result lists to a
    // short plugin detail content.
    preferred-height: search-field.text == "" ? root.empty-window-height : root.result-window-height;
    // Keep the empty launcher compact. Once a query has results, preserve
    // enough room for five rows while allowing the user to resize larger.
    min-height: search-field.text == "" ? root.empty-window-height : root.minimum-results-window-height;
    max-height: search-field.text == "" ? root.empty-window-height : 1000000px;
    background: transparent;

    in-out property <int> window-width: 900;
    in property <length> list-item-height: 50px;
    in property <length> grid-item-size: 124px;
    in property <bool> dark-mode: true;
    in property <color> accent-color: #0067c0;
    in property <color> accent-background: #280067c0;
    in property <image> search-icon;
    in property <string> search-icon-kind: "";
    in property <image> search-icon-previous;
    in property <string> search-icon-previous-kind: "";
    in property <float> search-icon-transition-progress: 1.0;
    in property <bool> search-icon-animation-enabled: true;
    in-out property <bool> search-icon-is-shortcut: false;
    in-out property <bool> detail-panel-visible: false;
    in property <string> detail-title: "";
    in property <string> detail-subtitle: "";
    in property <string> detail-source: "";
    in property <[DetailBlock]> detail-blocks;
    in property <[ContextActionRow]> detail-actions;
    in property <int> detail-panel-preferred-width: 0;
    in property <bool> detail-panel-scrollable: false;
    in-out property <string> launch-error: "";
    in-out property <string> last-action-id: "";
    in-out property <string> last-action-result: "";
    in-out property <string> last-action-subtitle: "";
    in property <[ResultRow]> results;
    in property <string> view-mode: "list";
    in-out property <string> query-text: "";
    in property <bool> shortcut-session-active: false;
    in property <bool> context-menu-open: false;
    in property <bool> context-menu-available: false;
    in-out property <int> selected-index: -1;
    // Local coordinates of the launcher's visible content bottom-right,
    // immediately above the operation hint. Keep this geometry in Slint so
    // layout changes do not require matching constants in platform code.
    // Expose the effective insets as geometry diagnostics so platform code
    // and manual layout checks can observe the same values as the anchor.
    out property <length> context-menu-anchor-right-inset: root.window-inset + root.context-menu-gap;
    out property <length> context-menu-anchor-bottom-inset: root.window-inset + root.content-bottom-padding + root.operation-hint-height + root.context-menu-gap;
    out property <length> context-menu-anchor-x: root.width - root.context-menu-anchor-right-inset;
    out property <length> context-menu-anchor-y: root.height - root.context-menu-anchor-bottom-inset;
    callback query-changed(string);
    callback visible-range-changed(int, int);
    callback selection-changed(int);
    callback launch-requested(int);
    callback shortcut-back-requested;
    callback detail-back-requested;
    callback detail-action-requested(int);
    callback detail-link-requested(string);
    callback context-menu-requested(int, bool);
    callback context-menu-dismissed;
    callback dismiss-requested;

    changed query-text => { root.query-changed(root.query-text); }

    // Primary density controls. Keep row geometry here so compactness can be tuned centrally.
    private property <length> search-row-height: 40px;
    private property <length> result-row-height: root.list-item-height;
    private property <length> result-icon-size: 24px;
    private property <length> empty-state-padding: 8px;
    private property <length> content-bottom-padding: search-field.text == "" ? root.empty-state-padding : 4px;
    private property <length> empty-window-height: 2 * root.window-inset + root.search-row-height + 2 * root.empty-state-padding;
    private property <length> minimum-results-window-height: 100px + 5 * root.result-row-height;
    in-out property <length> result-window-height: root.minimum-results-window-height;
    out property <bool> result-mode: search-field.text != "";
    private property <length> operation-hint-height: 24px;
    private property <length> context-menu-gap: 6px;
    private property <length> no-results-height: 76px;
    private property <length> window-inset: 4px;
    private property <length> content-padding: 10px;
    private property <length> content-spacing: 8px;
    private property <length> result-row-inset: 2px;
    private property <length> result-column-gap: root.window-inset + root.result-row-inset + root.detail-panel-inset;
    private property <length> detail-panel-inset: 2px;
    // Shift the list/panel split so the selected row's right edge and the
    // panel's left edge are equally far from the window center line. Both
    // edges move together, preserving their existing 8px separation.
    private property <length> detail-panel-alignment-shift: 6px;
    private property <length> detail-panel-bottom-inset: 6px;
    private property <length> grid-gap: 10px;
    private property <length> grid-min-cell-size: root.grid-item-size;
    private property <length> grid-row-height: root.grid-cell-size + root.grid-gap;
    // Grid cells stay square and fill the available width evenly. The
    // minimum size controls when another column is introduced.
    private property <int> grid-columns: max(1, floor((results-list.width + root.grid-gap) / (root.grid-min-cell-size + root.grid-gap)));
    private property <int> grid-row-count: (root.results.length + root.grid-columns - 1) / root.grid-columns;
    private property <length> grid-cell-size: max(root.grid-min-cell-size, (results-list.width - (root.grid-columns + 1) * root.grid-gap) / root.grid-columns);
    private property <float> detail-panel-share: root.detail-panel-preferred-width > 0 && root.width > 0px ? root.detail-panel-preferred-width / (root.width / 1px) : 0.5;
    private property <length> grid-cell-radius: 20px;
    private property <length> grid-icon-title-gap: 6px;
    private property <length> grid-title-height: max(24px, min(64px, root.grid-cell-size - root.grid-icon-size - 24px));
    private property <length> grid-content-height: root.grid-icon-size + root.grid-icon-title-gap + root.grid-title-height;
    private property <length> grid-icon-top: max(8px, (root.grid-cell-size - root.grid-content-height) / 2);
    private property <length> grid-title-inset: 10px;
    private property <length> grid-title-top: root.grid-icon-top + root.grid-icon-size + root.grid-icon-title-gap;
    private property <length> detail-block-height-step: 60px;
    private property <length> detail-block-spacing: 6px;
    private property <length> detail-action-footer-extra: 50px;
    private property <length> detail-panel-content-height: root.detail-content-footer-height + root.detail-blocks.length * root.detail-block-height-step + (root.detail-actions.length > 0 ? root.detail-action-footer-extra : 0px);
    private property <length> operation-hint-spacing: search-field.text != "" ? root.content-spacing + root.operation-hint-height : 0px;
    private property <length> no-results-spacing: search-field.text != "" && root.results.length == 0 ? root.content-spacing + root.no-results-height + root.content-spacing : 0px;
    private property <bool> grid-detail-active: root.view-mode == "grid" && root.detail-panel-active;
    private property <length> available-results-height: max(0px, root.height - 2 * root.window-inset - root.empty-state-padding - root.content-bottom-padding - (root.grid-detail-active ? 0px : root.search-row-height) - root.content-spacing - root.operation-hint-spacing - root.no-results-spacing);
    private property <length> visible-results-area-height: root.available-results-height;
    private property <bool> detail-visible: root.detail-panel-visible && root.selected-index >= 0;
    private property <float> detail-progress: root.detail-visible ? 1.0 : 0.0;
    animate detail-progress { duration: 180ms; easing: ease-out-back; }
    private property <float> detail-visual-progress: min(1.0, max(0.0, root.detail-progress));
    private property <length> detail-panel-width: (root.width - 2 * root.window-inset - 2 * root.content-padding) * root.detail-panel-share - root.detail-panel-alignment-shift;
    private property <bool> detail-panel-active: root.detail-visible || root.detail-progress > 0.0;
    private property <length> grid-icon-size: 44px;
    private property <length> detail-content-inset: 20px;
    private property <length> detail-header-top: 18px;
    private property <length> detail-subtitle-top: 44px;
    private property <length> detail-content-top: 76px;
    private property <length> detail-grid-header-x: 64px;
    private property <length> detail-grid-header-width-inset: 84px;
    private property <length> detail-content-footer-height: 118px;
    private property <length> detail-content-footer-with-actions-height: 168px;
    private property <length> detail-action-step: 104px;
    private property <length> detail-action-width: 96px;
    private property <length> detail-action-height: 28px;
    private property <length> detail-action-bottom: 78px;
    private property <length> detail-source-bottom: 42px;
    private property <color> detail-surface: root.dark-mode ? #242424 : #fbfcfe;
    private property <color> detail-raised-surface: root.dark-mode ? #2b2b2b : #f1f3f6;
    private property <color> detail-code-surface: root.dark-mode ? #181818 : #f1f3f6;
    private property <int> first-visible-index: root.view-mode == "grid" ? max(0, round(-grid-results.content-y / root.grid-row-height) * root.grid-columns) : max(0, round(-results-list.content-y / root.result-row-height));
    private property <bool> context-click-consumed: false;
    private property <int> last-visible-index: root.view-mode == "grid" ? min(root.results.length, (round((-grid-results.content-y + grid-results.height) / root.grid-row-height) + 1) * root.grid-columns) : min(root.results.length, round((-results-list.content-y + results-list.visible-height) / root.result-row-height) + 1);
    private property <color> canvas: root.dark-mode ? #202020 : #f8f9fb;
    private property <color> surface-hover: root.dark-mode ? #323232 : #f1f3f6;
    private property <color> surface-selected: root.accent-background;
    private property <color> border: root.dark-mode ? #484848 : #d9dde5;
    private property <color> text-primary: root.dark-mode ? #f5f5f5 : #1b1b1f;
    private property <color> text-secondary: root.dark-mode ? #b6b6b6 : #5d5f66;
    private property <color> text-tertiary: root.dark-mode ? #858585 : #797b82;
    private property <color> accent: root.accent-color;

    function ensure-selected-visible() {
        if (root.selected-index < 0 || root.selected-index >= root.results.length) { return; }
        if (root.view-mode == "grid") {
            let selected-row = root.selected-index / root.grid-columns;
            let selected-top = selected-row * root.grid-row-height + root.grid-gap + grid-results.content-y;
            let selected-bottom = selected-top + root.grid-cell-size;
            if (selected-top < 0px) {
                grid-results.content-y = min(0px, max(grid-results.height - grid-results.content-height, -selected-row * root.grid-row-height - root.grid-gap));
            }
            if (selected-bottom > grid-results.height) {
                grid-results.content-y = min(0px, max(grid-results.height - grid-results.content-height, grid-results.height - (selected-row + 1) * root.grid-row-height));
            }
            return;
        }
        if (root.selected-index * root.result-row-height + results-list.content-y < 0px) {
            results-list.content-y = min(0px, max(results-list.visible-height - results-list.content-height, -root.selected-index * root.result-row-height));
        }
        if (root.selected-index * root.result-row-height + root.result-row-height + results-list.content-y > results-list.visible-height) {
            results-list.content-y = min(0px, max(results-list.visible-height - results-list.content-height, results-list.visible-height - (root.selected-index + 1) * root.result-row-height));
        }
    }

    function move-grid-selection-left() {
        if (root.results.length == 0) { return; }
        if (root.selected-index < 0) {
            root.selected-index = 0;
            return;
        }
        let row-start = floor(root.selected-index / root.grid-columns) * root.grid-columns;
        root.selected-index = max(root.selected-index - 1, row-start);
    }

    function move-grid-selection-right() {
        if (root.results.length == 0) { return; }
        if (root.selected-index < 0) {
            root.selected-index = 0;
            return;
        }
        let row-end = min(root.results.length - 1, (floor(root.selected-index / root.grid-columns) + 1) * root.grid-columns - 1);
        root.selected-index = min(root.selected-index + 1, row-end);
    }

    function move-selection-down() {
        if (root.results.length == 0) { return; }
        root.selected-index = root.view-mode == "grid"
            ? (root.selected-index < 0 ? 0 : min(root.selected-index + root.grid-columns, root.results.length - 1))
            : min(root.selected-index + 1, root.results.length - 1);
    }

    function move-selection-up() {
        if (root.results.length == 0) { return; }
        root.selected-index = root.view-mode == "grid"
            ? (root.selected-index < 0 ? 0 : max(root.selected-index - root.grid-columns, 0))
            : max(root.selected-index - 1, 0);
    }

    changed selected-index => {
        root.ensure-selected-visible();
        root.selection-changed(root.selected-index);
    }
    changed first-visible-index => { root.visible-range-changed(root.first-visible-index, root.last-visible-index); }
    changed last-visible-index => { root.visible-range-changed(root.first-visible-index, root.last-visible-index); }
    changed view-mode => {
        if (root.view-mode == "grid") {
            root.detail-panel-visible = false;
        }
        results-list.content-y = 0px;
        grid-results.content-y = 0px;
        root.ensure-selected-visible();
        if (root.grid-detail-active) {
            detail-focus-scope.focus();
        }
        root.visible-range-changed(root.first-visible-index, root.last-visible-index);
    }
    changed detail-panel-active => {
        if (root.grid-detail-active) {
            detail-focus-scope.focus();
        } else if (!root.detail-panel-active) {
            search-field.focus();
        }
    }
    // Re-emit after replacing the model even when the calculated range stays
    // unchanged. Without this, newly visible rows can wait for a selection
    // or scroll event before their asynchronous icons are requested.
    changed results => { root.visible-range-changed(root.first-visible-index, root.last-visible-index); }
    changed visible-results-area-height => { root.visible-range-changed(root.first-visible-index, root.last-visible-index); }

    Rectangle {
        x: root.window-inset; y: root.window-inset;
        width: parent.width - 2 * root.window-inset;
        height: parent.height - 2 * root.window-inset;
        background: root.canvas;
        border-color: root.border;
        border-width: 1px;
        // Keep the shell flat and avoid a rounded clip layer on every frame.
        border-radius: 12px;

        VerticalBox {
            padding: root.content-padding;
            padding-top: root.empty-state-padding;
            padding-bottom: root.content-bottom-padding;
            spacing: root.content-spacing;

            Rectangle {
                z: 0;
                height: root.grid-detail-active ? 0px : root.search-row-height;
                background: transparent;
                clip: root.grid-detail-active;

                SearchGlyph {
                    x: 14px; y: (root.search-row-height - root.result-icon-size) / 2;
                    width: root.result-icon-size; height: root.result-icon-size;
                    source-image: root.search-icon; source-kind: root.search-icon-kind;
                    previous-image: root.search-icon-previous;
                    previous-kind: root.search-icon-previous-kind;
                    transition-progress: root.search-icon-transition-progress;
                    transition-animation-enabled: root.search-icon-animation-enabled;
                }
                Text { x: 48px; y: 0px; width: parent.width - 126px; height: parent.height; text: @tr("Search applications"); color: root.text-tertiary; font-size: 16px; vertical-alignment: center; visible: search-field.text == ""; }
                search-field := TextInput {
                    x: 48px; y: 0px; width: parent.width - 126px; height: root.search-row-height;
                    color: root.text-primary; font-size: 16px; vertical-alignment: center; single-line: true;
                    selection-background-color: root.accent-color;
                    selection-foreground-color: #ffffff;
                    text: root.query-text;
                    edited => { root.query-text = self.text; }
                    key-pressed(event) => {
                        if (event.text == Key.DownArrow) {
                            root.move-selection-down();
                            EventResult.accept
                        } else if (event.text == Key.UpArrow) {
                            root.move-selection-up();
                            EventResult.accept
                        } else if (root.view-mode == "grid" && event.text == Key.LeftArrow) {
                            root.move-grid-selection-left();
                            EventResult.accept
                        } else if (root.view-mode == "grid" && event.text == Key.RightArrow) {
                            root.move-grid-selection-right();
                            EventResult.accept
                        } else if ((event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) || (event.text == "m" && event.modifiers.control)) && root.selected-index >= 0) {
                            root.context-menu-requested(root.selected-index, true);
                            EventResult.accept
                        } else if (event.text == Key.Return && root.selected-index >= 0) {
                            root.launch-requested(root.selected-index);
                            EventResult.accept
                            } else if (event.text == Key.Escape) {
                            if (root.grid-detail-active) {
                                root.detail-back-requested();
                            } else if (root.shortcut-session-active) {
                                root.shortcut-back-requested();
                            } else {
                                root.dismiss-requested();
                            }
                            EventResult.accept
                        } else {
                            EventResult.reject
                        }
                    }
                }
            }

            results-area := Rectangle {
                height: root.visible-results-area-height;
                background: transparent;
                clip: true;

                results-list := ListView {
                    visible: root.view-mode == "list";
                    x: 0px; y: 0px;
                    // Grid mode keeps its full width because the detail view
                    // overlays the grid instead of becoming a side column.
                    width: root.view-mode == "grid"
                        ? parent.width
                        : parent.width - root.detail-progress * (parent.width * root.detail-panel-share + root.result-column-gap - root.detail-panel-alignment-shift);
                    height: parent.height;
                for row[index] in root.results : result-row := Rectangle {
                    x: root.result-row-inset;
                    width: results-list.visible-width - 2 * root.result-row-inset;
                        height: root.result-row-height;
                        private property <length> shortcut-card-width: row.shortcut_prefix_width * 1px;
                        private property <length> row-icon-size: row.presentation == "compact" ? 20px : row.presentation == "grid" ? 30px : root.result-icon-size;
                        private property <length> row-title-height: row.presentation == "compact" ? 16px : 18px;
                        private property <length> row-description-height: row.presentation == "compact" ? 14px : 16px;
                        private property <length> row-text-gap: 0px;
                        private property <length> row-text-height: row-title-height + row-text-gap + row-description-height;
                        private property <length> row-text-top: max(0px, (root.result-row-height - row-text-height) / 2);
                        background: index == root.selected-index ? root.surface-selected : item-area.has-hover ? root.surface-hover : transparent;
                        // Grid presentation changes density and typography,
                        // but result rows keep the same borderless surface as
                        // ordinary results. This avoids framing every Steam
                        // game result as a separate card.
                        border-color: transparent;
                        border-width: 0px;
                        border-radius: 8px;
                    item-area := TouchArea {
                        clicked => {
                            if (root.context-click-consumed) {
                                root.context-click-consumed = false;
                            } else {
                                root.launch-requested(index);
                            }
                        }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                root.context-menu-requested(index, false);
                                EventResult.accept
                            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down && root.context-menu-open) {
                                root.context-click-consumed = true;
                                root.context-menu-dismissed();
                                EventResult.accept
                            } else {
                                EventResult.reject
                            }
                        }
                    }
                    BuiltinIcon { visible: row.icon_kind != ""; x: 18px; y: (root.result-row-height - row-icon-size) / 2; width: row-icon-size; height: row-icon-size; kind: row.icon_kind; }
                    if row.icon_kind == "" : Image { x: 18px; y: (root.result-row-height - row-icon-size) / 2; width: row-icon-size; height: row-icon-size; source: row.icon; image-fit: contain; }
                    Rectangle {
                        x: 60px; y: 0px; width: row.shortcut_prefix == "" || root.detail-visible ? parent.width - 76px : parent.width - 60px - parent.shortcut-card-width; height: parent.height; background: transparent;
                        Text { x: 0px; y: row-text-top; width: parent.width; height: row-title-height; text: row.id == root.last-action-id && root.last-action-result != "" ? root.last-action-result : row.title; color: root.text-primary; font-size: row.presentation == "compact" ? 13px : row.presentation == "grid" ? 15px : 14px; font-weight: row.presentation == "grid" ? 400 : 500; vertical-alignment: center; overflow: elide; }
                        Text { x: 0px; y: row-text-top + row-title-height + row-text-gap; width: parent.width - 4px; height: row-description-height; text: row.id == root.last-action-id && root.last-action-subtitle != "" ? root.last-action-subtitle : row.location_kind == "control-panel" ? @tr("Control Panel") : row.location_kind == "application" && row.location == "" ? @tr("Application") : row.location; color: root.text-secondary; font-size: row.presentation == "compact" ? 10px : 11px; vertical-alignment: center; overflow: elide; }
                    }
                    Rectangle {
                        x: parent.width - shortcut-card-width - 10px; y: (root.result-row-height - 24px) / 2; width: shortcut-card-width; height: 24px;
                        background: root.dark-mode ? #303030 : #eef0f4;
                        border-color: root.border; border-width: 1px; border-radius: 6px;
                        visible: row.shortcut_prefix != "" && !root.detail-visible;
                        Text { width: parent.width - 8px; height: parent.height; x: 4px; text: row.shortcut_prefix; color: root.text-secondary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    }
                }
                }

                grid-results := Flickable {
                    visible: root.view-mode == "grid";
                    x: 0px; y: 0px; width: results-list.width; height: parent.height;
                    content-width: self.width;
                    content-height: max(self.height, root.grid-row-count * root.grid-row-height + root.grid-gap);
                    interactive: self.content-height > self.height;
                    if root.view-mode == "grid" : Rectangle {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        for row[index] in root.results : Rectangle {
                            x: root.grid-gap + Math.mod(index, root.grid-columns) * (root.grid-cell-size + root.grid-gap);
                            y: root.grid-gap + floor(index / root.grid-columns) * root.grid-row-height;
                            width: root.grid-cell-size;
                            height: root.grid-cell-size;
                            background: transparent;
                            border-color: transparent;
                            border-width: 0px;
                            grid-highlight := Rectangle {
                                x: 0px;
                                y: 0px;
                                width: root.grid-cell-size;
                                height: root.grid-cell-size;
                                background: index == root.selected-index ? root.surface-selected : grid-item-area.has-hover ? root.surface-hover : transparent;
                                border-radius: root.grid-cell-radius;
                            }
                            grid-item-area := TouchArea {
                                clicked => {
                                    if (root.context-click-consumed) {
                                        root.context-click-consumed = false;
                                    } else {
                                        root.launch-requested(index);
                                    }
                                }
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                        root.context-menu-requested(index, false);
                                        EventResult.accept
                                    } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down && root.context-menu-open) {
                                        root.context-click-consumed = true;
                                        root.context-menu-dismissed();
                                        EventResult.accept
                                    } else {
                                        EventResult.reject
                                    }
                                }
                            }
                            BuiltinIcon { visible: row.icon_kind != ""; x: (parent.width - root.grid-icon-size) / 2; y: root.grid-icon-top; width: root.grid-icon-size; height: root.grid-icon-size; kind: row.icon_kind; }
                            if row.icon_kind == "" : Image { x: (parent.width - root.grid-icon-size) / 2; y: root.grid-icon-top; width: root.grid-icon-size; height: root.grid-icon-size; source: row.icon; image-fit: contain; }
                            Text {
                                x: root.grid-title-inset;
                                y: root.grid-title-top;
                                width: parent.width - 2 * root.grid-title-inset;
                                height: root.grid-title-height;
                                text: row.id == root.last-action-id && root.last-action-result != "" ? root.last-action-result : row.title;
                                color: root.text-primary;
                                font-size: 12px;
                                font-weight: 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: char-wrap;
                                overflow: clip;
                            }
                            // Grid cells intentionally show only the result
                            // name. Descriptions and technical locations stay
                            // available in list view and the detail panel.
                        }
                    }
                }

                detail-panel := Rectangle {
                    // Grid mode uses the complete results area as a modal
                    // detail surface. Its fade/slide transition leaves the
                    // underlying square grid untouched.
                    private property <length> panel-width: root.view-mode == "grid" ? parent.width : root.detail-panel-width;
                    private property <length> panel-height: root.view-mode == "grid" ? parent.height : max(0px, parent.height - root.detail-panel-bottom-inset);
                    visible: root.detail-panel-active;
                    x: root.view-mode == "grid" ? 0px : results-list.width + root.result-column-gap - root.result-row-inset;
                    y: root.view-mode == "grid" ? (1.0 - root.detail-progress) * 24px : 0px;
                    width: root.view-mode == "grid" ? self.panel-width : self.panel-width * max(0.0, root.detail-progress);
                    height: self.panel-height;
                    // Keep the shell color stable while the content enters.
                    // The old panel opacity blended two different surfaces
                    // and produced a visible color flash in both modes.
                    background: root.detail-surface;
                    border-radius: 10px;
                    clip: true;
                    opacity: 1.0;

                    detail-focus-scope := FocusScope {
                        width: parent.width;
                        height: parent.height;
                        visible: root.grid-detail-active;
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.detail-back-requested();
                                accept
                            }
                            if (event.text == Key.DownArrow) {
                                root.move-selection-down();
                                accept
                            }
                            if (event.text == Key.UpArrow) {
                                root.move-selection-up();
                                accept
                            }
                            if (event.text == Key.LeftArrow) {
                                root.move-grid-selection-left();
                                accept
                            }
                            if (event.text == Key.RightArrow) {
                                root.move-grid-selection-right();
                                accept
                            }
                            if (event.text == Key.Return && root.selected-index >= 0) {
                                root.launch-requested(root.selected-index);
                                accept
                            }
                            reject
                        }
                    }

                    Flickable {
                        x: root.view-mode == "grid" ? 0px : parent.width - detail-panel.panel-width;
                        width: detail-panel.panel-width;
                        height: detail-panel.panel-height;
                        opacity: root.detail-visual-progress;
                        content-width: self.width;
                        content-height: max(self.height, root.detail-panel-content-height);
                        interactive: root.detail-panel-scrollable || root.detail-panel-content-height > self.height;

                        Rectangle {
                            width: parent.width;
                            height: max(parent.height, root.detail-panel-content-height);
                            background: transparent;

                            Text { x: root.view-mode == "grid" ? root.detail-grid-header-x : root.detail-content-inset; y: root.detail-header-top; width: parent.width - (root.view-mode == "grid" ? root.detail-grid-header-width-inset : 2 * root.detail-content-inset); height: 24px; text: root.detail-title; color: root.text-primary; font-size: 17px; font-weight: 600; overflow: elide; }
                    Text { x: root.view-mode == "grid" ? root.detail-grid-header-x : root.detail-content-inset; y: root.detail-subtitle-top; width: parent.width - (root.view-mode == "grid" ? root.detail-grid-header-width-inset : 2 * root.detail-content-inset); height: 18px; text: root.detail-subtitle; color: root.text-secondary; font-size: 11px; overflow: elide; }
                    VerticalBox {
                        x: root.detail-content-inset; y: root.detail-content-top; width: parent.width - 2 * root.detail-content-inset; height: parent.height - (root.detail-actions.length > 0 ? root.detail-content-footer-with-actions-height : root.detail-content-footer-height); spacing: root.detail-block-spacing;
                        for block in root.detail-blocks : Rectangle {
                            height: block.kind == "metric" ? 48px : block.kind == "weather" ? 48px : block.kind == "separator" ? 1px : block.kind == "icon" ? 40px : block.kind == "image" ? 120px : block.kind == "code" ? 96px : block.kind == "table" ? 80px : block.kind == "markdown" ? 48px : 24px;
                            background: transparent;
                            if (block.kind == "text") : Text {
                                width: parent.width; height: parent.height; text: block.value; color: block.color == "primary" ? root.text-primary : block.color == "accent" ? root.accent : root.text-secondary; font-size: 13px; vertical-alignment: center; overflow: elide;
                            }
                            if (block.kind == "markdown") : Text {
                                width: parent.width; height: parent.height; text: block.value; color: block.color == "primary" ? root.text-primary : block.color == "accent" ? root.accent : root.text-secondary; font-size: 13px; vertical-alignment: center; overflow: clip;
                            }
                            if (block.kind == "metric") : Rectangle {
                                width: parent.width; height: parent.height; background: root.dark-mode ? #2b2b2b : #f1f3f6; border-radius: 8px;
                                Text { x: 10px; y: 8px; width: parent.width - 20px; height: 14px; text: block.label; color: root.text-tertiary; font-size: 10px; }
                                Text { x: 10px; y: 26px; width: parent.width - 20px; height: 18px; text: block.value; color: block.color == "accent" ? root.accent : root.text-primary; font-size: 13px; font-weight: 600; overflow: elide; }
                            }
                            if (block.kind == "icon") : Image { width: parent.width; height: parent.height; source: block.icon; image-fit: contain; visible: block.icon.width > 0; }
                            if (block.kind == "icon") : Text { width: parent.width; height: parent.height; text: block.value; color: block.color == "accent" ? root.accent : root.text-primary; font-size: 32px; horizontal-alignment: center; vertical-alignment: center; visible: block.icon.width == 0; }
                            if (block.kind == "image") : Rectangle {
                                width: parent.width; height: parent.height; background: root.detail-raised-surface; border-radius: 8px;
                                Image { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px; source: block.icon; image-fit: contain; visible: block.icon.width > 0; }
                                Text { width: parent.width; height: parent.height; text: block.secondary == "" ? @tr("Preview unavailable") : block.secondary; color: root.text-secondary; horizontal-alignment: center; vertical-alignment: center; visible: block.icon.width == 0; overflow: elide; }
                            }
                            if (block.kind == "code") : Rectangle {
                                width: parent.width; height: parent.height; background: root.detail-code-surface; border-radius: 8px;
                                Text { x: 10px; y: 6px; width: parent.width - 20px; height: 14px; text: block.label; color: root.text-tertiary; font-size: 10px; visible: block.label != ""; }
                                Text { x: 10px; y: block.label == "" ? 8px : 24px; width: parent.width - 20px; height: parent.height - (block.label == "" ? 16px : 30px); text: block.value; color: root.text-primary; font-size: 11px; overflow: clip; }
                            }
                            if (block.kind == "table") : Rectangle {
                                width: parent.width; height: parent.height; background: root.detail-raised-surface; border-radius: 8px;
                                Text { x: 10px; y: 6px; width: parent.width - 20px; height: 16px; text: block.label; color: root.text-secondary; font-size: 10px; overflow: elide; }
                                Text { x: 10px; y: 24px; width: parent.width - 20px; height: parent.height - 30px; text: block.value; color: root.text-primary; font-size: 11px; overflow: clip; }
                            }
                            if (block.kind == "link") : Rectangle {
                                width: parent.width; height: parent.height; background: transparent;
                                Text { width: parent.width; height: parent.height; text: block.label + "  " + block.value; color: root.accent; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                TouchArea { clicked => { root.detail-link-requested(block.value); } }
                            }
                            if (block.kind == "loading") : Text {
                                width: parent.width; height: parent.height; text: "⏳  " + block.value; color: root.text-secondary; font-size: 12px; vertical-alignment: center; overflow: elide;
                            }
                            if (block.kind == "error") : Text {
                                width: parent.width; height: parent.height; text: "⚠  " + block.value; color: #d96c6c; font-size: 12px; vertical-alignment: center; overflow: elide;
                            }
                            if (block.kind == "separator") : Rectangle { y: 0px; width: parent.width; height: 1px; background: transparent; }
                            if (block.kind == "weather") : Text {
                                width: parent.width; height: parent.height;
                                text: block.value == "clear" ? "☀" : block.value == "snow" ? "❄" : block.value == "storm" ? "⚡" : block.value == "rain" ? "☂" : "☁";
                                color: block.value == "clear" ? #ffc144 : block.value == "storm" ? #ffd34e : block.value == "rain" ? #4da3e6 : #b8c5d4;
                                font-size: 38px; horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                    for action[index] in root.detail-actions : Rectangle {
                        x: root.detail-content-inset + index * root.detail-action-step; y: parent.height - root.detail-action-bottom; width: root.detail-action-width; height: root.detail-action-height;
                        background: action-area.has-hover ? root.surface-hover : root.detail-raised-surface;
                        border-color: root.border; border-width: 1px; border-radius: 7px;
                        action-area := TouchArea { clicked => { root.detail-action-requested(index); } }
                        BuiltinIcon { x: 8px; y: 6px; width: 16px; height: 16px; kind: action.icon_kind; }
                        if action.icon_kind == "" : Image { x: 8px; y: 6px; width: 16px; height: 16px; source: action.icon; image-fit: contain; }
                        Text { x: 28px; y: 0px; width: parent.width - 36px; height: parent.height; text: action.title; color: root.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    }
                    Text { x: root.detail-content-inset; y: parent.height - root.detail-source-bottom; width: parent.width - 2 * root.detail-content-inset; height: 18px; text: root.detail-source; color: root.text-tertiary; font-size: 10px; overflow: elide; }
                        }
                    }
                    if root.view-mode == "grid" : Rectangle {
                        x: 16px; y: 14px; width: 36px; height: 32px;
                        opacity: root.detail-visual-progress;
                        background: detail-back-button.has-hover ? root.surface-hover : transparent;
                        border-radius: 8px;
                        detail-back-button := TouchArea {
                            clicked => { root.detail-back-requested(); }
                        }
                        Text { width: parent.width; height: parent.height; text: "←"; color: root.text-secondary; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            if (root.results.length == 0 && search-field.text != "") : Rectangle { height: root.no-results-height; background: transparent; Text { text: @tr("No results"); color: root.text-secondary; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; } }

            if (search-field.text != "") : Rectangle {
                height: root.operation-hint-height; background: transparent;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: root.border; }
                Text { x: 10px; y: 1px; width: parent.width - 20px; height: parent.height - 1px; text: root.shortcut-session-active ? "Esc  Back" : root.view-mode == "grid" ? (root.context-menu-available ? @tr("↑ ↓ ← →  Navigate     Enter  Open     Ctrl+M  Context     Esc  Hide") : @tr("↑ ↓ ← →  Navigate     Enter  Open     Esc  Hide")) : (root.context-menu-available ? @tr("↑ ↓  Navigate     Enter  Open     Ctrl+M  Context     Esc  Hide") : @tr("↑ ↓  Navigate     Enter  Open     Esc  Hide")); color: root.text-tertiary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
    if (root.launch-error != "") : Rectangle {
        x: 18px; y: parent.height - 38px; width: parent.width - 36px; height: 26px;
        background: root.dark-mode ? #3b2525 : #fff0f0;
        border-color: #b85c5c; border-width: 1px; border-radius: 6px;
        Text { x: 8px; y: 0px; width: parent.width - 16px; height: parent.height; text: @tr("Could not open application") + ": " + root.launch-error; color: #d96c6c; font-size: 11px; vertical-alignment: center; overflow: elide; }
    }
}

export component ContextMenu inherits Window {
    title: "Wowie Context Menu";
    no-frame: true;
    forward-focus: focus-scope;
    in property <length> menu-width: 292px;
    width: root.menu-width;
    height: max(40px, 8px + root.actions.length * root.menu-item-height);
    background: transparent;

    in property <bool> dark-mode: true;
    in property <color> accent-color: #0067c0;
    in property <[ContextActionRow]> actions;
    in property <bool> keyboard-invoked: false;
    callback action-requested(string);
    callback dismissed;
    private property <int> selected-action-index: 0;

    private property <color> canvas: root.dark-mode ? #202020 : #f8f9fb;
    private property <color> hover: root.dark-mode ? #383838 : #eef1f5;
    private property <length> menu-item-height: 32px;
    private property <color> border: root.dark-mode ? #484848 : #d9dde5;
    private property <color> text-primary: root.dark-mode ? #f5f5f5 : #1b1b1f;
    private property <color> text-secondary: root.dark-mode ? #b6b6b6 : #5d5f66;

    changed actions => {
        root.selected-action-index = root.keyboard-invoked
            ? root.actions.length == 0 ? -1 : root.actions[0].kind == "section" ? (root.actions.length > 1 ? 1 : -1) : 0
            : -1;
        focus-scope.focus();
    }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.dismissed(); accept }
            if (event.text == Key.DownArrow && root.actions.length > 0) {
                let candidate = root.selected-action-index + 1;
                let wrapped = candidate >= root.actions.length ? 0 : max(candidate, 0);
                let next = root.actions[wrapped].kind == "section" ? (wrapped + 1 >= root.actions.length ? 0 : wrapped + 1) : wrapped;
                root.selected-action-index = next;
                accept
            }
            if (event.text == Key.UpArrow && root.actions.length > 0) {
                let candidate = root.selected-action-index - 1;
                let wrapped = candidate < 0 ? root.actions.length - 1 : candidate;
                let next = root.actions[wrapped].kind == "section" ? (wrapped - 1 < 0 ? root.actions.length - 1 : wrapped - 1) : wrapped;
                root.selected-action-index = next;
                accept
            }
            if (event.text == Key.Home && root.actions.length > 0) {
                root.selected-action-index = root.actions[0].kind == "section" ? (root.actions.length > 1 ? 1 : -1) : 0;
                accept
            }
            if (event.text == Key.End && root.actions.length > 0) {
                let last = root.actions.length - 1;
                root.selected-action-index = root.actions[last].kind == "section" ? max(last - 1, 0) : last;
                accept
            }
            if (event.text == Key.Return && root.selected-action-index >= 0 && root.actions[root.selected-action-index].kind != "section") {
                root.action-requested(root.actions[root.selected-action-index].id);
                accept
            }
            reject
        }

        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            background: root.canvas;
            border-color: root.border;
            border-width: 1px;
            border-radius: 8px;

            for action[index] in root.actions : Rectangle {
            x: 1px; y: 4px + index * root.menu-item-height;
            width: parent.width - 2px; height: root.menu-item-height;
            background: action.kind == "section" ? root.canvas : index == root.selected-action-index ? root.hover : action-area.has-hover ? root.hover : root.canvas;
            border-radius: 6px;
            action-area := TouchArea {
                enabled: action.kind != "section";
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                        root.action-requested(action.id);
                        EventResult.accept
                    } else {
                        EventResult.reject
                    }
                }
            }
            BuiltinIcon { x: 14px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; kind: action.icon_kind; }
            if action.icon_kind == "" : Image { x: 14px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: action.icon; image-fit: contain; }
            Text {
                x: 36px; y: action.subtitle == "" ? 0px : 2px; width: action.shortcut == "" ? parent.width - 50px : parent.width - 162px;
                height: action.subtitle == "" ? parent.height : 16px;
                text: action.kind == "section" ? @tr("Other launch entries") : action.id == "open-directory" ? @tr("Open containing folder") : action.id == "run-as-admin" ? @tr("Run as administrator") : action.title;
                color: action.kind == "section" ? root.text-secondary : root.text-primary;
                font-size: action.kind == "section" ? 11px : 13px;
                vertical-alignment: center; overflow: elide;
            }
            Text { x: 36px; y: 17px; width: action.shortcut == "" ? parent.width - 50px : parent.width - 162px; height: 12px; text: action.subtitle; color: root.text-secondary; font-size: 10px; vertical-alignment: center; overflow: elide; visible: action.subtitle != ""; }
            Text { x: parent.width - 120px; y: 0px; width: 108px; height: parent.height; text: action.shortcut; color: root.text-secondary; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; visible: action.shortcut != ""; }
            }
        }
    }

}
