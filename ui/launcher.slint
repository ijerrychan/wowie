import { HorizontalBox, VerticalBox, ListView } from "std-widgets.slint";

export struct ResultRow { id: string, title: string, location: string, location_kind: string, icon: image, icon_kind: string, shortcut_prefix: string, shortcut_prefix_width: int }
export struct ContextActionRow { id: string, title: string, subtitle: string, kind: string, icon: image, icon_kind: string }
export struct DetailBlock { kind: string, label: string, value: string, color: string, icon: image }

component BuiltinIcon inherits Image {
    in property <string> kind;
    visible: root.kind != "";
    image-fit: contain;
    source: root.kind == "weather" ? @image-url("../assets/icons/weather.svg")
        : root.kind == "calculator" ? @image-url("../assets/icons/calculator.svg")
        : root.kind == "book" ? @image-url("../assets/icons/book-open.svg")
        : root.kind == "checklist" ? @image-url("../assets/icons/list-checks.svg")
        : root.kind == "folder-open" ? @image-url("../assets/icons/folder-open-outline.svg")
        : root.kind == "shield-account" ? @image-url("../assets/icons/shield-account-outline.svg")
        : @image-url("../wowie.png");
}

component SearchGlyph inherits Rectangle {
    in property <image> source-image;
    in property <string> source-kind;
    in property <image> previous-image;
    in property <string> previous-kind;
    in property <float> transition-progress: 1.0;
    in property <bool> transition-animation-enabled: true;
    background: transparent;
    clip: true;

    private property <float> animated-progress: root.transition-progress;
    private property <float> outgoing-scale: max(0.0, 1.0 - root.animated-progress);
    private property <float> incoming-scale: 0.72 + root.animated-progress * 0.28;
    animate animated-progress {
        duration: 180ms;
        easing: ease-out-back;
        enabled: root.transition-animation-enabled;
    }

    Rectangle {
        x: (parent.width - parent.width * root.outgoing-scale) / 2;
        y: (parent.height - parent.height * root.outgoing-scale) / 2;
        width: parent.width * root.outgoing-scale;
        height: parent.height * root.outgoing-scale;
        background: transparent;
        BuiltinIcon {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            kind: root.previous-kind;
            opacity: max(0.0, 1.0 - root.animated-progress);
        }
        if root.previous-kind == "" : Image {
            width: parent.width; height: parent.height;
            source: root.previous-image.width > 0 ? root.previous-image : @image-url("../assets/icons/magnify.svg");
            image-fit: contain;
            opacity: max(0.0, 1.0 - root.animated-progress);
        }
    }

    Rectangle {
        x: (parent.width - parent.width * root.incoming-scale) / 2;
        y: (parent.height - parent.height * root.incoming-scale) / 2;
        width: parent.width * root.incoming-scale;
        height: parent.height * root.incoming-scale;
        background: transparent;
        BuiltinIcon {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            kind: root.source-kind;
            opacity: min(1.0, root.animated-progress);
        }
        if root.source-kind == "" : Image {
            width: parent.width; height: parent.height;
            source: root.source-image.width > 0 ? root.source-image : @image-url("../assets/icons/magnify.svg");
            image-fit: contain;
            opacity: min(1.0, root.animated-progress);
        }
    }
}

export component Launcher inherits Window {
    title: "Wowie";
    no-frame: true;
    // Let the winit backend expose native resize cursors and edge/corner
    // dragging for this frameless launcher.
    resize-border-width: 8px;
    preferred-width: window-width * 1px;
    min-width: 520px;
    // With details open, both columns contribute to the window's required
    // height. Using only the detail card here clipped long result lists to a
    // short plugin detail such as the devtools TODO card.
    preferred-height: search-field.text == "" ? root.empty-window-height : root.result-window-height;
    // Keep the empty launcher compact. Once a query has results, preserve
    // enough room for five rows while allowing the user to resize larger.
    min-height: search-field.text == "" ? root.empty-window-height : root.minimum-results-window-height;
    max-height: search-field.text == "" ? root.empty-window-height : 1000000px;
    background: transparent;

    in-out property <int> window-width: 900;
    in property <bool> dark-mode: true;
    in property <color> accent-color: #0067c0;
    in property <color> accent-background: #280067c0;
    in property <image> search-icon;
    in property <string> search-icon-kind: "";
    in property <image> search-icon-previous;
    in property <string> search-icon-previous-kind: "";
    in property <float> search-icon-transition-progress: 1.0;
    in property <bool> search-icon-animation-enabled: true;
    in-out property <bool> search-icon-is-shortcut: false;
    in property <bool> detail-panel-visible: false;
    in property <string> detail-title: "";
    in property <string> detail-subtitle: "";
    in property <string> detail-source: "";
    in property <[DetailBlock]> detail-blocks;
    in property <[ContextActionRow]> detail-actions;
    in property <int> detail-panel-preferred-width: 0;
    in property <bool> detail-panel-scrollable: false;
    in-out property <string> launch-error: "";
    in-out property <string> last-action-id: "";
    in-out property <string> last-action-result: "";
    in-out property <string> last-action-subtitle: "";
    in property <[ResultRow]> results;
    in property <bool> context-menu-open: false;
    in-out property <int> selected-index: -1;
    callback query-changed(string);
    callback visible-range-changed(int, int);
    callback selection-changed(int);
    callback launch-requested(int);
    callback detail-action-requested(int);
    callback context-menu-requested(int);
    callback context-menu-dismissed;
    callback dismiss-requested;

    // Primary density controls. Keep row geometry here so compactness can be tuned centrally.
    private property <length> search-row-height: 40px;
    private property <length> result-row-height: 50px;
    private property <length> result-icon-size: 24px;
    private property <length> result-content-height: 40px;
    private property <length> result-content-offset: 2px;
    private property <length> empty-state-padding: 8px;
    private property <length> content-bottom-padding: search-field.text == "" ? root.empty-state-padding : 4px;
    private property <length> empty-window-height: 2 * root.window-inset + root.search-row-height + 2 * root.empty-state-padding;
    private property <length> minimum-results-window-height: 100px + 5 * root.result-row-height;
    in-out property <length> result-window-height: root.minimum-results-window-height;
    out property <bool> result-mode: search-field.text != "";
    private property <length> operation-hint-height: 24px;
    private property <length> no-results-height: 76px;
    private property <length> window-inset: 4px;
    private property <length> content-padding: 10px;
    private property <length> content-spacing: 8px;
    private property <length> result-row-inset: 2px;
    private property <length> result-column-gap: root.window-inset + root.result-row-inset + root.detail-panel-inset;
    private property <length> detail-panel-inset: 2px;
    // Shift the list/panel split so the selected row's right edge and the
    // panel's left edge are equally far from the window center line. Both
    // edges move together, preserving their existing 8px separation.
    private property <length> detail-panel-alignment-shift: 6px;
    private property <length> detail-panel-bottom-inset: 6px;
    private property <float> detail-panel-share: root.detail-panel-preferred-width > 0 && root.width > 0px ? root.detail-panel-preferred-width / (root.width / 1px) : 0.5;
    private property <length> detail-panel-content-height: 118px + root.detail-blocks.length * 60px + (root.detail-actions.length > 0 ? 50px : 0px);
    private property <length> desired-results-area-height: root.detail-visible ? min(398px, max(root.results.length * root.result-row-height, root.detail-panel-content-height)) : min(398px, root.results.length * root.result-row-height);
    private property <length> operation-hint-spacing: search-field.text != "" ? root.content-spacing + root.operation-hint-height : 0px;
    private property <length> no-results-spacing: search-field.text != "" && root.results.length == 0 ? root.content-spacing + root.no-results-height + root.content-spacing : 0px;
    private property <length> available-results-height: max(0px, root.height - 2 * root.window-inset - root.empty-state-padding - root.content-bottom-padding - root.search-row-height - root.content-spacing - root.operation-hint-spacing - root.no-results-spacing);
    private property <length> visible-results-area-height: root.available-results-height;
    private property <bool> detail-visible: root.detail-panel-visible && root.selected-index >= 0;
    private property <float> detail-progress: root.detail-visible ? 1.0 : 0.0;
    animate detail-progress { duration: 180ms; easing: ease-out-back; }
    private property <int> first-visible-index: max(0, round(-results-list.content-y / root.result-row-height));
    private property <bool> context-click-consumed: false;
    private property <int> last-visible-index: min(root.results.length, round((-results-list.content-y + results-list.visible-height) / root.result-row-height) + 1);
    private property <color> canvas: root.dark-mode ? #202020 : #f8f9fb;
    private property <color> surface-hover: root.dark-mode ? #323232 : #f1f3f6;
    private property <color> surface-selected: root.accent-background;
    private property <color> border: root.dark-mode ? #484848 : #d9dde5;
    private property <color> text-primary: root.dark-mode ? #f5f5f5 : #1b1b1f;
    private property <color> text-secondary: root.dark-mode ? #b6b6b6 : #5d5f66;
    private property <color> text-tertiary: root.dark-mode ? #858585 : #797b82;
    private property <color> accent: root.accent-color;

    function ensure-selected-visible() {
        if (root.selected-index < 0 || root.selected-index >= root.results.length) { return; }
        if (root.selected-index * root.result-row-height + results-list.content-y < 0px) {
            results-list.content-y = min(0px, max(results-list.visible-height - results-list.content-height, -root.selected-index * root.result-row-height));
        }
        if (root.selected-index * root.result-row-height + root.result-row-height + results-list.content-y > results-list.visible-height) {
            results-list.content-y = min(0px, max(results-list.visible-height - results-list.content-height, results-list.visible-height - (root.selected-index + 1) * root.result-row-height));
        }
    }

    changed selected-index => {
        root.ensure-selected-visible();
        root.selection-changed(root.selected-index);
    }
    changed first-visible-index => { root.visible-range-changed(root.first-visible-index, root.last-visible-index); }
    changed last-visible-index => { root.visible-range-changed(root.first-visible-index, root.last-visible-index); }
    // Re-emit after replacing the model even when the calculated range stays
    // unchanged. Without this, newly visible rows can wait for a selection
    // or scroll event before their asynchronous icons are requested.
    changed results => { root.visible-range-changed(root.first-visible-index, root.last-visible-index); }
    changed visible-results-area-height => { root.visible-range-changed(root.first-visible-index, root.last-visible-index); }

    Rectangle {
        x: root.window-inset; y: root.window-inset;
        width: parent.width - 2 * root.window-inset;
        height: parent.height - 2 * root.window-inset;
        background: root.canvas;
        border-color: root.border;
        border-width: 1px;
        // Keep the shell flat and avoid a rounded clip layer on every frame.
        border-radius: 12px;

        VerticalBox {
            padding: root.content-padding;
            padding-top: root.empty-state-padding;
            padding-bottom: root.content-bottom-padding;
            spacing: root.content-spacing;

            Rectangle {
                height: root.search-row-height;
                background: transparent;

                SearchGlyph {
                    x: 14px; y: (root.search-row-height - root.result-icon-size) / 2;
                    width: root.result-icon-size; height: root.result-icon-size;
                    source-image: root.search-icon; source-kind: root.search-icon-kind;
                    previous-image: root.search-icon-previous;
                    previous-kind: root.search-icon-previous-kind;
                    transition-progress: root.search-icon-transition-progress;
                    transition-animation-enabled: root.search-icon-animation-enabled;
                }
                Text { x: 48px; y: 0px; width: parent.width - 126px; height: parent.height; text: @tr("Search applications"); color: root.text-tertiary; font-size: 16px; vertical-alignment: center; visible: search-field.text == ""; }
                search-field := TextInput {
                    x: 48px; y: 0px; width: parent.width - 126px; height: root.search-row-height;
                    color: root.text-primary; font-size: 16px; vertical-alignment: center; single-line: true;
                    selection-background-color: root.accent-color;
                    selection-foreground-color: #ffffff;
                    edited => { root.query-changed(self.text); }
                    key-pressed(event) => {
                        if (event.text == Key.DownArrow) { root.selected-index = min(root.selected-index + 1, root.results.length - 1); accept }
                        if (event.text == Key.UpArrow) { root.selected-index = max(root.selected-index - 1, 0); accept }
                        if (event.text == Key.Return && root.selected-index >= 0) { root.launch-requested(root.selected-index); accept }
                        if (event.text == Key.Escape) { root.dismiss-requested(); accept }
                        reject
                    }
                }
            }

            results-area := Rectangle {
                height: root.visible-results-area-height;
                background: transparent;
                clip: true;

                results-list := ListView {
                    x: 0px; y: 0px;
                    width: parent.width - root.detail-progress * (parent.width * root.detail-panel-share + root.result-column-gap - root.detail-panel-alignment-shift);
                    height: parent.height;
                for row[index] in root.results : result-row := Rectangle {
                    x: root.result-row-inset;
                    width: parent.width - 2 * root.result-row-inset;
                        height: root.result-row-height;
                        private property <length> shortcut-card-width: row.shortcut_prefix_width * 1px;
                        background: index == root.selected-index ? root.surface-selected : item-area.has-hover ? root.surface-hover : transparent;
                        border-radius: 8px;
                    item-area := TouchArea {
                        clicked => {
                            if (root.context-click-consumed) {
                                root.context-click-consumed = false;
                            } else {
                                root.launch-requested(index);
                            }
                        }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                root.context-menu-requested(index);
                                EventResult.accept
                            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down && root.context-menu-open) {
                                root.context-click-consumed = true;
                                root.context-menu-dismissed();
                                EventResult.accept
                            } else {
                                EventResult.reject
                            }
                        }
                    }
                    BuiltinIcon { visible: !root.search-icon-is-shortcut && row.icon_kind != ""; x: 18px; y: (root.result-row-height - root.result-icon-size) / 2; width: root.result-icon-size; height: root.result-icon-size; kind: row.icon_kind; }
                    if row.icon_kind == "" : Image { visible: !root.search-icon-is-shortcut; x: 18px; y: (root.result-row-height - root.result-icon-size) / 2; width: root.result-icon-size; height: root.result-icon-size; source: row.icon; image-fit: contain; }
                    VerticalBox {
                        x: 60px; y: root.result-content-offset; width: row.shortcut_prefix == "" || root.detail-visible ? parent.width - 76px : parent.width - 60px - parent.shortcut-card-width; height: root.result-content-height; spacing: 2px;
                        Text { text: row.id == root.last-action-id && root.last-action-result != "" ? root.last-action-result : row.title; color: root.text-primary; font-size: 14px; font-weight: 500; overflow: elide; }
                        Text { width: parent.width - 4px; text: row.id == root.last-action-id && root.last-action-subtitle != "" ? root.last-action-subtitle : row.location_kind == "control-panel" ? @tr("Control Panel") : row.location_kind == "application" && row.location == "" ? @tr("Application") : row.location; color: root.text-secondary; font-size: 11px; overflow: elide; }
                    }
                    Rectangle {
                        x: parent.width - shortcut-card-width - 10px; y: (root.result-row-height - 24px) / 2; width: shortcut-card-width; height: 24px;
                        background: root.dark-mode ? #303030 : #eef0f4;
                        border-color: root.border; border-width: 1px; border-radius: 6px;
                        visible: row.shortcut_prefix != "" && !root.detail-visible;
                        Text { width: parent.width - 8px; height: parent.height; x: 4px; text: row.shortcut_prefix; color: root.text-secondary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    }
                }
                }

                detail-panel := Rectangle {
                    // Keep the panel mounted and reveal it from its fixed
                    // right edge. Width/height are not scaled, so the card
                    // content never stretches during the entrance animation.
                    private property <length> panel-width: parent.width * root.detail-panel-share - root.detail-panel-alignment-shift;
                    private property <length> panel-height: max(0px, parent.height - root.detail-panel-bottom-inset);
                    visible: root.detail-visible;
                    // Follow the animated list edge directly. This keeps the
                    // gap constant throughout the entrance and prevents the
                    // highlighted row from sliding underneath the panel.
                    x: results-list.width + root.result-column-gap - root.result-row-inset;
                    y: 0px;
                    width: self.panel-width * max(0.0, root.detail-progress);
                    height: self.panel-height;
                    background: root.dark-mode ? #242424 : #fbfcfe;
                    border-radius: 10px;
                    clip: true;
                    opacity: root.detail-visible ? 1.0 : 0.0;

                    Flickable {
                        x: parent.width - detail-panel.panel-width;
                        width: detail-panel.panel-width;
                        height: detail-panel.panel-height;
                        content-width: self.width;
                        content-height: max(self.height, root.detail-panel-content-height);
                        interactive: root.detail-panel-scrollable || root.detail-panel-content-height > self.height;

                        Rectangle {
                            width: parent.width;
                            height: max(parent.height, root.detail-panel-content-height);
                            background: transparent;

                            Text { x: 20px; y: 18px; width: parent.width - 40px; height: 24px; text: root.detail-title; color: root.text-primary; font-size: 17px; font-weight: 600; overflow: elide; }
                    Text { x: 20px; y: 44px; width: parent.width - 40px; height: 18px; text: root.detail-subtitle; color: root.text-secondary; font-size: 11px; overflow: elide; }
                    VerticalBox {
                        x: 20px; y: 76px; width: parent.width - 40px; height: parent.height - (root.detail-actions.length > 0 ? 168px : 118px); spacing: 6px;
                        for block in root.detail-blocks : Rectangle {
                            height: block.kind == "metric" ? 48px : block.kind == "weather" ? 48px : block.kind == "separator" ? 1px : block.kind == "icon" ? 40px : 24px;
                            background: transparent;
                            if (block.kind == "text") : Text {
                                width: parent.width; height: parent.height; text: block.value; color: block.color == "primary" ? root.text-primary : block.color == "accent" ? root.accent : root.text-secondary; font-size: 13px; vertical-alignment: center; overflow: elide;
                            }
                            if (block.kind == "metric") : Rectangle {
                                width: parent.width; height: parent.height; background: root.dark-mode ? #2b2b2b : #f1f3f6; border-radius: 8px;
                                Text { x: 10px; y: 8px; width: parent.width - 20px; height: 14px; text: block.label; color: root.text-tertiary; font-size: 10px; }
                                Text { x: 10px; y: 26px; width: parent.width - 20px; height: 18px; text: block.value; color: block.color == "accent" ? root.accent : root.text-primary; font-size: 13px; font-weight: 600; overflow: elide; }
                            }
                            if (block.kind == "icon") : Image { width: parent.width; height: parent.height; source: block.icon; image-fit: contain; visible: block.icon.width > 0; }
                            if (block.kind == "icon") : Text { width: parent.width; height: parent.height; text: block.value; color: block.color == "accent" ? root.accent : root.text-primary; font-size: 32px; horizontal-alignment: center; vertical-alignment: center; visible: block.icon.width == 0; }
                            if (block.kind == "separator") : Rectangle { y: 0px; width: parent.width; height: 1px; background: transparent; }
                            if (block.kind == "weather") : Text {
                                width: parent.width; height: parent.height;
                                text: block.value == "clear" ? "☀" : block.value == "snow" ? "❄" : block.value == "storm" ? "⚡" : block.value == "rain" ? "☂" : "☁";
                                color: block.value == "clear" ? #ffc144 : block.value == "storm" ? #ffd34e : block.value == "rain" ? #4da3e6 : #b8c5d4;
                                font-size: 38px; horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                    for action[index] in root.detail-actions : Rectangle {
                        x: 20px + index * 104px; y: parent.height - 78px; width: 96px; height: 28px;
                        background: action-area.has-hover ? root.surface-hover : root.dark-mode ? #2b2b2b : #f1f3f6;
                        border-color: root.border; border-width: 1px; border-radius: 7px;
                        action-area := TouchArea { clicked => { root.detail-action-requested(index); } }
                        BuiltinIcon { x: 8px; y: 6px; width: 16px; height: 16px; kind: action.icon_kind; }
                        if action.icon_kind == "" : Image { x: 8px; y: 6px; width: 16px; height: 16px; source: action.icon; image-fit: contain; }
                        Text { x: 28px; y: 0px; width: parent.width - 36px; height: parent.height; text: action.title; color: root.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    }
                            Text { x: 20px; y: parent.height - 42px; width: parent.width - 40px; height: 18px; text: root.detail-source; color: root.text-tertiary; font-size: 10px; overflow: elide; }
                        }
                    }
                }
            }

            if (root.results.length == 0 && search-field.text != "") : Rectangle { height: root.no-results-height; background: transparent; Text { text: @tr("No results"); color: root.text-secondary; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; } }

            if (search-field.text != "") : Rectangle {
                height: root.operation-hint-height; background: transparent;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: root.border; }
                Text { x: 10px; y: 1px; width: parent.width - 20px; height: parent.height - 1px; text: @tr("↑ ↓  Navigate     Enter  Open     Esc  Hide"); color: root.text-tertiary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
    if (root.launch-error != "") : Rectangle {
        x: 18px; y: parent.height - 38px; width: parent.width - 36px; height: 26px;
        background: root.dark-mode ? #3b2525 : #fff0f0;
        border-color: #b85c5c; border-width: 1px; border-radius: 6px;
        Text { x: 8px; y: 0px; width: parent.width - 16px; height: parent.height; text: @tr("Could not open application") + ": " + root.launch-error; color: #d96c6c; font-size: 11px; vertical-alignment: center; overflow: elide; }
    }
}

export component ContextMenu inherits Window {
    title: "Wowie Context Menu";
    no-frame: true;
    in property <length> menu-width: 292px;
    width: root.menu-width;
    height: max(40px, 8px + root.actions.length * root.menu-item-height);
    background: transparent;

    in property <bool> dark-mode: true;
    in property <color> accent-color: #0067c0;
    in property <[ContextActionRow]> actions;
    callback action-requested(string);
    callback dismissed;

    private property <color> canvas: root.dark-mode ? #202020 : #f8f9fb;
    private property <color> hover: root.dark-mode ? #383838 : #eef1f5;
    private property <length> menu-item-height: 32px;
    private property <color> border: root.dark-mode ? #484848 : #d9dde5;
    private property <color> text-primary: root.dark-mode ? #f5f5f5 : #1b1b1f;
    private property <color> text-secondary: root.dark-mode ? #b6b6b6 : #5d5f66;

    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: root.canvas;
        border-color: root.border;
        border-width: 1px;
        border-radius: 8px;

        for action[index] in root.actions : Rectangle {
            x: 1px; y: 4px + index * root.menu-item-height;
            width: parent.width - 2px; height: root.menu-item-height;
            background: action.kind == "section" ? root.canvas : action-area.has-hover ? root.hover : root.canvas;
            border-radius: 6px;
            action-area := TouchArea {
                enabled: action.kind != "section";
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                        root.action-requested(action.id);
                        EventResult.accept
                    } else {
                        EventResult.reject
                    }
                }
            }
            BuiltinIcon { x: 14px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; kind: action.icon_kind; }
            if action.icon_kind == "" : Image { x: 14px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: action.icon; image-fit: contain; }
            Text {
                x: 36px; y: action.subtitle == "" ? 0px : 2px; width: parent.width - 50px;
                height: action.subtitle == "" ? parent.height : 16px;
                text: action.kind == "section" ? @tr("Other launch entries") : action.id == "open-directory" ? @tr("Open containing folder") : action.id == "run-as-admin" ? @tr("Run as administrator") : action.title;
                color: action.kind == "section" ? root.text-secondary : root.text-primary;
                font-size: action.kind == "section" ? 11px : 13px;
                vertical-alignment: center; overflow: elide;
            }
            Text { x: 36px; y: 17px; width: parent.width - 50px; height: 12px; text: action.subtitle; color: root.text-secondary; font-size: 10px; vertical-alignment: center; overflow: elide; visible: action.subtitle != ""; }
        }
    }

}
