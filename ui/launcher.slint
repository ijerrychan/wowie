import { VerticalBox, ListView } from "std-widgets.slint";

export struct ResultRow { id: string, title: string, location: string, location_kind: string, icon: image, icon_kind: string, favorite: bool, shortcut_prefix: string, shortcut_prefix_width: int, presentation: string }
export struct ContextActionRow { id: string, title: string, subtitle: string, kind: string, icon: image, icon_kind: string, shortcut: string }
export struct DetailBlock { kind: string, label: string, value: string, color: string, secondary: string, icon: image, height: int }

component BuiltinIcon inherits Image {
    in property <string> kind;
    visible: root.kind != "";
    image-fit: contain;
    source: root.kind == "weather" ? @image-url("../assets/icons/weather.svg")
        : root.kind == "calculator" ? @image-url("../assets/icons/calculator.svg")
        : root.kind == "book" ? @image-url("../assets/icons/book-open.svg")
        : root.kind == "checklist" ? @image-url("../assets/icons/list-checks.svg")
        : root.kind == "folder-open" ? @image-url("../assets/icons/folder-open-outline.svg")
        : root.kind == "shield-account" ? @image-url("../assets/icons/shield-account-outline.svg")
        : root.kind == "content-copy" ? @image-url("../assets/icons/content-copy.svg")
        : root.kind == "star" ? @image-url("../assets/icons/star.svg")
        : root.kind == "magnify" ? @image-url("../assets/icons/magnify.svg")
        : root.kind == "arrow-left-dark" ? @image-url("../assets/icons/arrow-left-dark.svg")
        : root.kind == "arrow-left-light" ? @image-url("../assets/icons/arrow-left-light.svg")
        : @image-url("../wowie.png");
}

component SearchGlyph inherits Rectangle {
    in property <image> source-image;
    in property <string> source-kind;
    in property <image> previous-image;
    in property <string> previous-kind;
    in property <float> transition-progress: 1.0;
    in property <bool> transition-animation-enabled: true;
    background: transparent;
    clip: true;

    private property <float> animated-progress: root.transition-progress;
    private property <float> outgoing-scale: max(0.0, 1.0 - root.animated-progress);
    private property <float> incoming-scale: 0.72 + root.animated-progress * 0.28;
    animate animated-progress {
        duration: 180ms;
        easing: ease-out-back;
        enabled: root.transition-animation-enabled;
    }

    Rectangle {
        x: (parent.width - parent.width * root.outgoing-scale) / 2;
        y: (parent.height - parent.height * root.outgoing-scale) / 2;
        width: parent.width * root.outgoing-scale;
        height: parent.height * root.outgoing-scale;
        background: transparent;
        BuiltinIcon {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            kind: root.previous-kind;
            opacity: max(0.0, 1.0 - root.animated-progress);
        }
        if root.previous-kind == "" : Image {
            width: parent.width; height: parent.height;
            source: root.previous-image.width > 0 ? root.previous-image : @image-url("../assets/icons/magnify.svg");
            image-fit: contain;
            opacity: max(0.0, 1.0 - root.animated-progress);
        }
    }

    Rectangle {
        x: (parent.width - parent.width * root.incoming-scale) / 2;
        y: (parent.height - parent.height * root.incoming-scale) / 2;
        width: parent.width * root.incoming-scale;
        height: parent.height * root.incoming-scale;
        background: transparent;
        BuiltinIcon {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            kind: root.source-kind;
            opacity: min(1.0, root.animated-progress);
        }
        if root.source-kind == "" : Image {
            width: parent.width; height: parent.height;
            source: root.source-image.width > 0 ? root.source-image : @image-url("../assets/icons/magnify.svg");
            image-fit: contain;
            opacity: min(1.0, root.animated-progress);
        }
    }
}

export component Launcher inherits Window {
    title: "Wowie";
    no-frame: true;
    // Let the winit backend expose native resize cursors and edge/corner
    // dragging for this frameless launcher.
    resize-border-width: 8px;
    preferred-width: window-width * 1px;
    min-width: 520px;
    // With details open, both columns contribute to the window's required
    // height. Using only the detail card here clipped long result lists to a
    // short plugin detail content.
    preferred-height: root.effective-window-height;
    default-font-family: root.ui-font-family;
    default-font-size: root.ui-font-size;
    // Preserve enough room for five rows while allowing the user to resize larger.
    min-height: root.compact-results-hidden ? root.compact-window-height : root.minimum-results-window-height;
    max-height: 1000000px;
    background: transparent;

    in-out property <int> window-width: 900;
    in property <string> ui-font-family: "";
    in property <length> ui-font-size: 14px;
    in property <bool> compact-search: false;
    in property <bool> root-query-empty: true;
    in-out property <bool> empty-query-results-visible: false;
    in property <length> list-item-height: 50px;
    in property <bool> dark-mode: true;
    in property <color> accent-color: #0067c0;
    in property <color> accent-background: #280067c0;
    in property <image> search-icon;
    in property <string> search-icon-kind: "";
    in property <image> search-icon-previous;
    in property <string> search-icon-previous-kind: "";
    in property <float> search-icon-transition-progress: 1.0;
    in property <bool> search-icon-animation-enabled: true;
    in-out property <bool> search-icon-is-shortcut: false;
    in-out property <bool> detail-panel-visible: false;
    in-out property <bool> empty-state-detail-active: false;
    in property <string> empty-state-title: "";
    in property <string> empty-state-description: "";
    in property <image> empty-state-icon;
    in property <int> empty-state-icon-generation: 0;
    in property <string> empty-state-icon-kind: "";
    in property <string> detail-title: "";
    in property <string> detail-subtitle: "";
    in property <string> detail-source: "";
    in property <int> detail-content-generation: 0;
    in property <[DetailBlock]> detail-blocks;
    in property <[ContextActionRow]> detail-actions;
    in property <int> detail-panel-preferred-width: 0;
    in property <bool> detail-panel-scrollable: false;
    in-out property <string> launch-error: "";
    in-out property <string> last-action-id: "";
    in-out property <string> last-action-result: "";
    in-out property <string> last-action-subtitle: "";
    in property <[ResultRow]> results;
    in-out property <string> query-text: "";
    in-out property <bool> query-results-ready: false;
    in-out property <int> query-history-restore-id: 0;
    in-out property <int> query-history-cursor: 0;
    in property <bool> shortcut-session-active: false;
    in property <bool> shortcut-session-execute-mode: false;
    in property <string> shortcut-session-prefix: "";
    in property <string> shortcut-session-placeholder: "";
    in property <bool> context-menu-open: false;
    in property <bool> context-menu-available: false;
    in-out property <int> selected-index: -1;
    // Local coordinates of the launcher's visible content bottom-right,
    // immediately above the operation hint. Keep this geometry in Slint so
    // layout changes do not require matching constants in platform code.
    // Expose the effective insets as geometry diagnostics so platform code
    // and manual layout checks can observe the same values as the anchor.
    out property <length> context-menu-anchor-right-inset: root.window-inset + root.context-menu-gap;
    out property <length> context-menu-anchor-bottom-inset: root.window-inset + root.content-bottom-padding + root.operation-hint-height + root.context-menu-gap;
    out property <length> context-menu-anchor-x: root.width - root.context-menu-anchor-right-inset;
    out property <length> context-menu-anchor-y: root.height - root.context-menu-anchor-bottom-inset;
    callback query-changed(string);
    callback compact-results-requested;
    callback normalize-query(string) -> string;
    callback query-history-up-requested;
    callback visible-range-changed(int, int);
    callback selection-changed(int);
    callback launch-requested(int);
    callback shortcut-back-requested;
    callback search-back-requested;
    callback session-execute-requested;
    callback empty-state-activated;

    changed query-history-restore-id => {
        search-field.set-selection-offsets(root.query-history-cursor, root.query-history-cursor);
    }
    callback detail-back-requested;
    callback detail-action-requested(int);
    callback detail-link-requested(string);
    callback context-menu-requested(int, bool);
    callback context-menu-dismissed;
    callback dismiss-requested;

    // Primary density controls. Keep row geometry here so compactness can be tuned centrally.
    private property <length> search-row-height: 40px;
    private property <length> result-row-height: root.list-item-height;
    private property <length> result-icon-size: 24px;
    private property <length> empty-state-padding: 8px;
    private property <length> content-bottom-padding: 4px;
    private property <length> minimum-results-window-height: 100px + 5 * root.result-row-height;
    in-out property <length> result-window-height: root.minimum-results-window-height;
    out property <length> effective-window-height: root.compact-results-hidden ? root.compact-window-height : root.result-window-height;
    private property <length> compact-window-height: 2 * root.window-inset + 2 * root.empty-state-padding + root.search-row-height;
    private property <bool> compact-results-hidden: root.compact-search && root.root-query-empty && !root.shortcut-session-active && !root.empty-query-results-visible;
    private property <length> operation-hint-height: 24px;
    private property <length> context-menu-gap: 6px;
    private property <length> no-results-height: 160px;
    private property <length> window-inset: 4px;
    private property <length> content-padding: 10px;
    private property <length> content-spacing: 8px;
    private property <length> result-row-inset: 2px;
    private property <length> result-column-gap: root.window-inset + root.result-row-inset + root.detail-panel-inset;
    private property <length> detail-panel-inset: 2px;
    // Shift the list/panel split so the selected row's right edge and the
    // panel's left edge are equally far from the window center line. Both
    // edges move together, preserving their existing 8px separation.
    private property <length> detail-panel-alignment-shift: 6px;
    private property <length> detail-panel-bottom-inset: 6px;
    private property <float> detail-panel-share: root.detail-panel-preferred-width > 0 && root.width > 0px ? root.detail-panel-preferred-width / (root.width / 1px) : 0.5;
    // Text blocks may wrap into several lines. Keep enough measured content
    // height for the Flickable to expose a real scroll range instead of
    // clipping the tail of a long translation.
    in property <length> detail-content-height: 0px;
    private property <length> detail-block-spacing: 6px;
    private property <length> detail-action-footer-extra: 50px;
    private property <length> detail-panel-content-height: root.detail-content-footer-height + root.detail-content-height + (root.detail-actions.length > 0 ? root.detail-action-footer-extra : 0px);
    private property <length> operation-hint-spacing: root.content-spacing + root.operation-hint-height;
    private property <length> no-results-spacing: 0px;
    // Keep the session transition geometry together so the search field and
    // both icons always move as one unit.
    private property <length> session-back-width: 22px;
    private property <length> session-icon-x: 28px;
    private property <length> default-icon-x: 14px;
    private property <length> session-input-x: 60px;
    private property <length> default-input-x: 48px;
    // Keep the placeholder and the focused text at the same six-pixel inset.
    // Cursor visibility uses the same margin when the field receives focus.
    private property <length> search-input-scroll-x: 6px;
    private property <duration> session-transition-duration: 150ms;
    private property <duration> session-fade-duration: 100ms;
    private property <length> search-row-layout-height: root.search-row-height;
    private property <length> available-results-height: root.compact-results-hidden ? 0px : max(0px, root.height - 2 * root.window-inset - root.empty-state-padding - root.content-bottom-padding - root.search-row-layout-height - root.content-spacing - root.operation-hint-spacing - root.no-results-spacing);
    private property <bool> detail-visible: root.detail-panel-visible && (root.selected-index >= 0 || root.empty-state-detail-active);
    private property <float> detail-progress: root.detail-visible ? 1.0 : 0.0;
    animate detail-progress {
        duration: 180ms;
        easing: root.detail-visible ? ease-out-back : ease-in;
    }
    private property <length> detail-panel-width: (root.width - 2 * root.window-inset - 2 * root.content-padding) * root.detail-panel-share - root.detail-panel-alignment-shift;
    private property <bool> detail-panel-active: root.detail-visible || root.detail-progress > 0.0;
    private property <length> detail-content-inset: 20px;
    private property <length> detail-header-top: 18px;
    private property <length> detail-subtitle-top: 44px;
    private property <length> detail-content-top: 76px;
    private property <length> detail-content-footer-height: 118px;
    private property <length> detail-content-footer-with-actions-height: 168px;
    private property <length> detail-action-step: 104px;
    private property <length> detail-action-width: 96px;
    private property <length> detail-action-height: 28px;
    private property <length> detail-action-bottom: 78px;
    private property <length> detail-source-bottom: 42px;
    private property <color> detail-surface: root.dark-mode ? #242424 : #fbfcfe;
    private property <color> detail-raised-surface: root.dark-mode ? #2b2b2b : #f1f3f6;
    private property <color> detail-code-surface: root.dark-mode ? #181818 : #f1f3f6;
    private property <int> first-visible-index: max(0, round(-results-list.content-y / root.result-row-height));
    private property <bool> context-click-consumed: false;
    private property <int> last-visible-index: min(root.results.length, round((-results-list.content-y + results-list.visible-height) / root.result-row-height) + 1);
    private property <color> canvas: root.dark-mode ? #202020 : #f8f9fb;
    private property <color> surface-hover: root.dark-mode ? #323232 : #f1f3f6;
    private property <color> surface-selected: root.accent-background;
    private property <color> border: root.dark-mode ? #484848 : #d9dde5;
    private property <color> text-primary: root.dark-mode ? #f5f5f5 : #1b1b1f;
    private property <color> text-secondary: root.dark-mode ? #b6b6b6 : #5d5f66;
    private property <color> text-tertiary: root.dark-mode ? #858585 : #797b82;
    private property <color> accent: root.accent-color;

    function ensure-selected-visible() {
        if (root.selected-index < 0 || root.selected-index >= root.results.length) { return; }
        if (root.selected-index * root.result-row-height + results-list.content-y < 0px) {
            results-list.content-y = min(0px, max(results-list.visible-height - results-list.content-height, -root.selected-index * root.result-row-height));
        }
        if (root.selected-index * root.result-row-height + root.result-row-height + results-list.content-y > results-list.visible-height) {
            results-list.content-y = min(0px, max(results-list.visible-height - results-list.content-height, results-list.visible-height - (root.selected-index + 1) * root.result-row-height));
        }
    }

    function move-selection-down() {
        if (root.compact-search && root.root-query-empty && !root.shortcut-session-active && !root.empty-query-results-visible) {
            root.empty-query-results-visible = true;
            root.compact-results-requested();
        }
        if (root.results.length == 0) { return; }
        root.selected-index = min(root.selected-index + 1, root.results.length - 1);
    }

    function move-selection-up() {
        if (root.results.length == 0) { return; }
        root.selected-index = max(root.selected-index - 1, 0);
    }

    changed selected-index => {
        root.ensure-selected-visible();
        root.selection-changed(root.selected-index);
    }
    changed first-visible-index => { root.visible-range-changed(root.first-visible-index, root.last-visible-index); }
    changed last-visible-index => { root.visible-range-changed(root.first-visible-index, root.last-visible-index); }
    changed detail-panel-active => {
        if (!root.detail-panel-active) {
            search-field.focus();
        }
    }
    // The host coalesces range notifications on the next event-loop turn, so
    // layout and selection changes cannot synchronously rebuild the ListView.
    changed available-results-height => { root.visible-range-changed(root.first-visible-index, root.last-visible-index); }

    Rectangle {
        x: root.window-inset; y: root.window-inset;
        width: parent.width - 2 * root.window-inset;
        height: parent.height - 2 * root.window-inset;
        background: root.canvas;
        border-color: root.border;
        border-width: 1px;
        // Keep the shell flat and avoid a rounded clip layer on every frame.
        border-radius: 12px;

        VerticalBox {
            padding: root.content-padding;
            padding-top: root.empty-state-padding;
            padding-bottom: root.compact-results-hidden ? root.empty-state-padding : root.content-bottom-padding;
            spacing: root.content-spacing;

            Rectangle {
                z: 0;
                height: root.search-row-layout-height;
                background: transparent;

                back-button := Rectangle {
                    x: root.shortcut-session-active ? 0px : -root.session-back-width;
                    y: 0px; width: root.session-back-width; height: parent.height;
                    opacity: root.shortcut-session-active ? 1.0 : 0.0;
                    clip: true;
                    animate x { duration: root.session-transition-duration; easing: ease-out-back; }
                    animate opacity { duration: root.session-fade-duration; }
                    back-hit := TouchArea {
                        width: parent.width; height: parent.height;
                        clicked => { root.search-back-requested(); }
                    }
                    Rectangle {
                        x: 0px; y: max(0px, (parent.height - 28px) / 2); width: root.session-back-width; height: min(parent.height, 28px);
                        border-radius: 7px;
                        // Do not let the hover pill linger while this button
                        // slides out after returning from a search engine.
                        background: root.shortcut-session-active && back-hit.has-hover ? root.surface-hover : transparent;
                        BuiltinIcon { x: 5px; y: (parent.height - 12px) / 2; width: 12px; height: 12px; kind: root.dark-mode ? "arrow-left-light" : "arrow-left-dark"; }
                    }
                }
                SearchGlyph {
                    x: root.shortcut-session-active ? root.session-icon-x : root.default-icon-x; y: (root.search-row-layout-height - root.result-icon-size) / 2;
                    width: root.result-icon-size; height: root.result-icon-size;
                    animate x { duration: root.session-transition-duration; easing: ease-out-back; }
                    source-image: root.search-icon; source-kind: root.search-icon-kind;
                    previous-image: root.search-icon-previous;
                    previous-kind: root.search-icon-previous-kind;
                    transition-progress: root.search-icon-transition-progress;
                    transition-animation-enabled: root.search-icon-animation-enabled;
                }
                Rectangle {
                    x: root.shortcut-session-active ? root.session-input-x : root.default-input-x; y: 0px; width: parent.width - (root.shortcut-session-active ? 70px : 58px); height: root.search-row-layout-height;
                    background: transparent;
                    clip: true;
                    animate x { duration: root.session-transition-duration; easing: ease-out-back; }
                    animate width { duration: root.session-transition-duration; easing: ease-out-back; }
                    Text {
                        x: root.search-input-scroll-x; y: 0px; width: parent.width - root.search-input-scroll-x; height: parent.height;
                        text: root.shortcut-session-active ? root.shortcut-session-placeholder : @tr("Search apps, files, settings, and more");
                        color: root.text-tertiary; font-size: 1.1429rem; vertical-alignment: center;
                        visible: search-field.text == "";
                    }
                    search-field := TextInput {
                        x: root.search-input-scroll-x; y: 0px; width: max(parent.width, self.preferred-width); height: parent.height;
                        color: root.text-primary; font-size: 1.1429rem; vertical-alignment: center; horizontal-alignment: left; single-line: true;
                        selection-background-color: root.accent-color;
                        selection-foreground-color: #ffffff;
                        text <=> root.query-text;
                        cursor-position-changed(cursor-position) => {
                            let margin = 6px;
                            if (cursor-position.x + root.search-input-scroll-x < margin) {
                                root.search-input-scroll-x = margin - cursor-position.x;
                            } else if (cursor-position.x + root.search-input-scroll-x > parent.width - margin - self.text-cursor-width) {
                                root.search-input-scroll-x = parent.width - margin - cursor-position.x - self.text-cursor-width;
                            }
                        }
                        edited => {
                            let normalized = root.normalize-query(self.text);
                            if (normalized != self.text) {
                                self.text = normalized;
                            }
                            root.query-results-ready = false;
                            root.query-changed(self.text);
                        }
                        key-pressed(event) => {
                            if (event.text == Key.DownArrow) {
                                root.move-selection-down();
                                EventResult.accept
                            } else if (event.text == Key.UpArrow) {
                                root.move-selection-up();
                                EventResult.accept
                            } else if ((event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) || (event.text == "m" && event.modifiers.control)) && root.selected-index >= 0) {
                                root.context-menu-requested(root.selected-index, true);
                                EventResult.accept
                            // A visible row, including a persisted session-history
                            // row, is the user's explicit choice. Only fall back
                            // to executing the raw input when no row is selected.
                            } else if (event.text == Key.Return && root.selected-index >= 0) {
                                root.launch-requested(root.selected-index);
                                EventResult.accept
                            } else if (event.text == Key.Return && root.shortcut-session-execute-mode) {
                                root.session-execute-requested();
                                EventResult.accept
                            } else if (event.text == Key.Return && root.selected-index < 0 && root.empty-state-title != "") {
                                root.empty-state-activated();
                                EventResult.accept
                            } else if (event.text == Key.Escape) {
                                if (root.detail-visible) {
                                    root.detail-back-requested();
                                } else if (root.shortcut-session-active) {
                                    root.shortcut-back-requested();
                                } else {
                                    root.dismiss-requested();
                                }
                                EventResult.accept
                            } else {
                                EventResult.reject
                            }
                        }
                    }
                }
            }

            results-area := Rectangle {
                height: root.available-results-height;
                background: transparent;
                clip: true;

                results-list := ListView {
                    visible: !root.compact-results-hidden;
                    x: 0px; y: 0px;
                    width: parent.width - root.detail-progress * (parent.width * root.detail-panel-share + root.result-column-gap - root.detail-panel-alignment-shift);
                    height: parent.height;
                for row[index] in root.results : result-row := Rectangle {
                    x: root.result-row-inset;
                    width: results-list.visible-width - 2 * root.result-row-inset;
                        height: root.result-row-height;
                        private property <length> shortcut-card-width: row.shortcut_prefix_width * 1px;
                        private property <length> row-icon-size: row.presentation == "compact" ? 20px : root.result-icon-size;
                        private property <length> row-title-height: row.presentation == "compact" ? 16px : 18px;
                        private property <length> row-description-height: row.presentation == "compact" ? 14px : 16px;
                        private property <length> row-text-gap: 0px;
                        private property <length> row-text-height: row-title-height + row-text-gap + row-description-height;
                        private property <length> row-text-top: max(0px, (root.result-row-height - row-text-height) / 2);
                        background: index == root.selected-index ? root.surface-selected : item-area.has-hover ? root.surface-hover : transparent;
                        border-color: transparent;
                        border-width: 0px;
                        border-radius: 8px;
                    item-area := TouchArea {
                        clicked => {
                            if (root.context-click-consumed) {
                                root.context-click-consumed = false;
                            } else {
                                root.launch-requested(index);
                            }
                        }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                root.context-menu-requested(index, false);
                                EventResult.accept
                            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down && root.context-menu-open) {
                                root.context-click-consumed = true;
                                root.context-menu-dismissed();
                                EventResult.accept
                            } else {
                                EventResult.reject
                            }
                        }
                    }
                    BuiltinIcon { visible: row.icon_kind != ""; x: 18px; y: (root.result-row-height - row-icon-size) / 2; width: row-icon-size; height: row-icon-size; kind: row.icon_kind; }
                    if row.icon_kind == "" : Image { x: 18px; y: (root.result-row-height - row-icon-size) / 2; width: row-icon-size; height: row-icon-size; source: row.icon; image-fit: contain; }
                    Rectangle {
                        x: 60px; y: 0px; width: row.shortcut_prefix == "" || root.detail-visible ? parent.width - 76px - (row.favorite ? 22px : 0px) : parent.width - 60px - parent.shortcut-card-width - (row.favorite ? 40px : 0px); height: parent.height; background: transparent;
                        Text { x: 0px; y: row-text-top; width: parent.width; height: row-title-height; text: row.id == root.last-action-id && root.last-action-result != "" ? root.last-action-result : row.title; color: root.text-primary; font-size: row.presentation == "compact" ? 0.9286rem : 1.0000rem; font-weight: 500; vertical-alignment: center; overflow: elide; }
                        Text { x: 0px; y: row-text-top + row-title-height + row-text-gap; width: parent.width - 4px; height: row-description-height; text: row.id == root.last-action-id && root.last-action-subtitle != "" ? root.last-action-subtitle : row.location_kind == "control-panel" ? @tr("Control Panel") : row.location_kind == "application" && row.location == "" ? @tr("Application") : row.location; color: root.text-secondary; font-size: row.presentation == "compact" ? 0.7143rem : 0.7857rem; vertical-alignment: center; overflow: elide; }
                    }
                    Rectangle {
                        x: parent.width - shortcut-card-width - 10px; y: (root.result-row-height - 24px) / 2; width: shortcut-card-width; height: 24px;
                        background: root.dark-mode ? #303030 : #eef0f4;
                        border-color: root.border; border-width: 1px; border-radius: 6px;
                        visible: row.shortcut_prefix != "" && !root.detail-visible;
                        Text { width: parent.width - 8px; height: parent.height; x: 4px; text: row.shortcut_prefix; color: root.text-secondary; font-size: 0.7857rem; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    }
                    if row.favorite : BuiltinIcon {
                        x: row.shortcut_prefix == "" || root.detail-visible ? parent.width - 26px : parent.width - shortcut-card-width - 32px;
                        y: (root.result-row-height - 16px) / 2;
                        width: 16px; height: 16px; kind: "star";
                    }
                }
                }

                detail-panel := Rectangle {
                    private property <length> panel-width: root.detail-panel-width;
                    private property <length> panel-height: max(0px, parent.height - root.detail-panel-bottom-inset);
                    visible: root.detail-panel-active;
                    x: results-list.width + root.result-column-gap - root.result-row-inset;
                    y: (1.0 - root.detail-progress) * 24px;
                    width: self.panel-width * max(0.0, root.detail-progress);
                    height: self.panel-height;
                    background: root.detail-surface;
                    border-radius: 10px;
                    clip: true;

                    Flickable {
                        x: parent.width - detail-panel.panel-width;
                        width: detail-panel.panel-width;
                        height: detail-panel.panel-height;
                        content-width: self.width;
                        content-height: max(self.height, root.detail-panel-content-height);
                        interactive: root.detail-panel-scrollable || root.detail-panel-content-height > self.height;

                        Rectangle {
                            width: parent.width;
                            height: max(parent.height, root.detail-panel-content-height);
                            background: transparent;

                            Text { x: root.detail-content-inset; y: root.detail-header-top; width: parent.width - 2 * root.detail-content-inset; height: 24px; text: root.detail-title; color: root.text-primary; font-size: 1.2143rem; font-weight: 600; overflow: elide; }
                    Text { x: root.detail-content-inset; y: root.detail-subtitle-top; width: parent.width - 2 * root.detail-content-inset; height: 18px; text: root.detail-subtitle; color: root.text-secondary; font-size: 0.7857rem; overflow: elide; }
                    VerticalBox {
                        x: root.detail-content-inset; y: root.detail-content-top; width: parent.width - 2 * root.detail-content-inset; height: parent.height - (root.detail-actions.length > 0 ? root.detail-content-footer-with-actions-height : root.detail-content-footer-height); spacing: root.detail-block-spacing;
                        for block in root.detail-blocks : Rectangle {
                            height: block.height * 1px;
                            background: transparent;
                            if (block.kind == "text" || block.kind == "text-copyable") : Rectangle {
                                width: parent.width; height: parent.height;
                                if (block.kind == "text-copyable") : TextInput { width: parent.width; height: parent.height; text: block.value; color: block.color == "primary" ? root.text-primary : block.color == "accent" ? root.accent : root.text-secondary; font-size: 0.9286rem; vertical-alignment: top; single-line: false; wrap: word-wrap; read-only: true; selection-background-color: root.accent-color; selection-foreground-color: #ffffff; }
                                if (block.kind == "text") : Text { width: parent.width; height: parent.height; text: block.value; color: block.color == "primary" ? root.text-primary : block.color == "accent" ? root.accent : root.text-secondary; font-size: 0.9286rem; vertical-alignment: top; wrap: word-wrap; overflow: clip; }
                            }
                            if (block.kind == "markdown" || block.kind == "markdown-copyable") : Rectangle {
                                width: parent.width; height: parent.height;
                                if (block.kind == "markdown-copyable") : TextInput { width: parent.width; height: parent.height; text: block.value; color: block.color == "primary" ? root.text-primary : block.color == "accent" ? root.accent : root.text-secondary; font-size: 0.9286rem; vertical-alignment: top; single-line: false; wrap: word-wrap; read-only: true; selection-background-color: root.accent-color; selection-foreground-color: #ffffff; }
                                if (block.kind == "markdown") : Text { width: parent.width; height: parent.height; text: block.value; color: block.color == "primary" ? root.text-primary : block.color == "accent" ? root.accent : root.text-secondary; font-size: 0.9286rem; vertical-alignment: top; wrap: word-wrap; overflow: clip; }
                            }
                            if (block.kind == "metric") : Rectangle {
                                width: parent.width; height: parent.height; background: root.dark-mode ? #2b2b2b : #f1f3f6; border-radius: 8px;
                                Text { x: 10px; y: 8px; width: parent.width - 20px; height: 14px; text: block.label; color: root.text-tertiary; font-size: 0.7143rem; }
                                Text { x: 10px; y: 26px; width: parent.width - 20px; height: 18px; text: block.value; color: block.color == "accent" ? root.accent : root.text-primary; font-size: 0.9286rem; font-weight: 600; overflow: elide; }
                            }
                            if (block.kind == "icon") : Image { width: parent.width; height: parent.height; source: block.icon; image-fit: contain; visible: block.icon.width > 0; }
                            if (block.kind == "icon") : Text { width: parent.width; height: parent.height; text: block.value; color: block.color == "accent" ? root.accent : root.text-primary; font-size: 2.2857rem; horizontal-alignment: center; vertical-alignment: center; visible: block.icon.width == 0; }
                            if (block.kind == "image") : Rectangle {
                                width: parent.width; height: parent.height; background: root.detail-raised-surface; border-radius: 8px;
                                Image { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px; source: block.icon; image-fit: contain; visible: block.icon.width > 0; }
                                Text { width: parent.width; height: parent.height; text: block.secondary == "" ? @tr("Preview unavailable") : block.secondary; color: root.text-secondary; horizontal-alignment: center; vertical-alignment: center; visible: block.icon.width == 0; overflow: elide; }
                            }
                            if (block.kind == "code") : Rectangle {
                                width: parent.width; height: parent.height; background: root.detail-code-surface; border-radius: 8px;
                                Text { x: 10px; y: 6px; width: parent.width - 20px; height: 14px; text: block.label; color: root.text-tertiary; font-size: 0.7143rem; visible: block.label != ""; }
                                Text { x: 10px; y: block.label == "" ? 8px : 24px; width: parent.width - 20px; height: parent.height - (block.label == "" ? 16px : 30px); text: block.value; color: root.text-primary; font-size: 0.7857rem; overflow: clip; }
                            }
                            if (block.kind == "table") : Rectangle {
                                width: parent.width; height: parent.height; background: root.detail-raised-surface; border-radius: 8px;
                                Text { x: 10px; y: 6px; width: parent.width - 20px; height: 16px; text: block.label; color: root.text-secondary; font-size: 0.7143rem; overflow: elide; }
                                Text { x: 10px; y: 24px; width: parent.width - 20px; height: parent.height - 30px; text: block.value; color: root.text-primary; font-size: 0.7857rem; overflow: clip; }
                            }
                            if (block.kind == "link") : Rectangle {
                                width: parent.width; height: parent.height; background: transparent;
                                Text { width: parent.width; height: parent.height; text: block.label + "  " + block.value; color: root.accent; font-size: 0.8571rem; vertical-alignment: center; overflow: elide; }
                                TouchArea { clicked => { root.detail-link-requested(block.value); } }
                            }
                            if (block.kind == "loading") : Text {
                                width: parent.width; height: parent.height; text: "⏳  " + block.value; color: root.text-secondary; font-size: 0.8571rem; vertical-alignment: center; overflow: elide;
                            }
                            if (block.kind == "error") : Text {
                                width: parent.width; height: parent.height; text: "⚠  " + block.value; color: #d96c6c; font-size: 0.8571rem; vertical-alignment: center; overflow: elide;
                            }
                            if (block.kind == "separator") : Rectangle { y: 0px; width: parent.width; height: 1px; background: transparent; }
                            if (block.kind == "weather") : Text {
                                width: parent.width; height: parent.height;
                                text: block.value == "clear" ? "☀" : block.value == "snow" ? "❄" : block.value == "storm" ? "⚡" : block.value == "rain" ? "☂" : "☁";
                                color: block.value == "clear" ? #ffc144 : block.value == "storm" ? #ffd34e : block.value == "rain" ? #4da3e6 : #b8c5d4;
                                font-size: 2.7143rem; horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                    for action[index] in root.detail-actions : Rectangle {
                        x: root.detail-content-inset + index * root.detail-action-step; y: parent.height - root.detail-action-bottom; width: root.detail-action-width; height: root.detail-action-height;
                        background: action-area.has-hover ? root.surface-hover : root.detail-raised-surface;
                        border-color: root.border; border-width: 1px; border-radius: 7px;
                        action-area := TouchArea { clicked => { root.detail-action-requested(index); } }
                        BuiltinIcon { x: 8px; y: 6px; width: 16px; height: 16px; kind: action.icon_kind; }
                        if action.icon_kind == "" : Image { x: 8px; y: 6px; width: 16px; height: 16px; source: action.icon; image-fit: contain; }
                        Text { x: 28px; y: 0px; width: parent.width - 36px; height: parent.height; text: action.title; color: root.text-secondary; font-size: 0.7143rem; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    }
                    Text { x: root.detail-content-inset; y: parent.height - root.detail-source-bottom; width: parent.width - 2 * root.detail-content-inset; height: 18px; text: root.detail-source; color: root.text-tertiary; font-size: 0.7143rem; overflow: elide; }
                        }
                    }
                }
                if (root.results.length == 0 && (search-field.text != "" || root.shortcut-session-active) && root.query-results-ready && !root.detail-visible) : Rectangle {
                    x: 0px;
                    y: max(0px, (parent.height - root.no-results-height) / 2);
                    width: parent.width; height: root.no-results-height; background: transparent;
                    TouchArea { clicked => { if (root.empty-state-title != "") { root.empty-state-activated(); } } }
                    if root.empty-state-icon-kind != "" : BuiltinIcon { x: (parent.width - 44px) / 2; y: 0px; width: 44px; height: 44px; kind: root.empty-state-icon-kind; }
                    if root.empty-state-icon-kind == "" && root.empty-state-icon.width > 0 : Image { x: (parent.width - 44px) / 2; y: 0px; width: 44px; height: 44px; source: root.empty-state-icon; image-fit: contain; }
                    if root.empty-state-icon-kind == "" && root.empty-state-icon.width == 0 : BuiltinIcon { x: (parent.width - 36px) / 2; y: 4px; width: 36px; height: 36px; kind: "magnify"; }
                    Text { x: 24px; y: 52px; width: parent.width - 48px; height: 40px; text: root.empty-state-title != "" ? root.empty-state-title : @tr("No results"); color: root.text-secondary; font-size: 1.0714rem; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; overflow: clip; }
                    if root.empty-state-description != "" : Text { x: 24px; y: 98px; width: parent.width - 48px; height: 58px; text: root.empty-state-description; color: root.text-tertiary; font-size: 0.8571rem; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; overflow: clip; }
                }
            }

            if (!root.compact-results-hidden) : Rectangle {
                height: root.operation-hint-height; background: transparent;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: root.border; }
                Text { x: 10px; y: 1px; width: parent.width - 20px; height: parent.height - 1px; text: root.context-menu-available ? (root.shortcut-session-active ? @tr("↑ ↓  Navigate     Enter  Open     Ctrl+M  Context     Esc  Back") : @tr("↑ ↓  Navigate     Enter  Open     Ctrl+M  Context     Esc  Hide")) : (root.shortcut-session-active ? @tr("↑ ↓  Navigate     Enter  Open     Esc  Back") : @tr("↑ ↓  Navigate     Enter  Open     Esc  Hide")); color: root.text-tertiary; font-size: 0.7857rem; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
    if (root.launch-error != "") : Rectangle {
        x: 18px; y: parent.height - 38px; width: parent.width - 36px; height: 26px;
        background: root.dark-mode ? #3b2525 : #fff0f0;
        border-color: #b85c5c; border-width: 1px; border-radius: 6px;
        Text { x: 8px; y: 0px; width: parent.width - 16px; height: parent.height; text: @tr("Could not open application") + ": " + root.launch-error; color: #d96c6c; font-size: 0.7857rem; vertical-alignment: center; overflow: elide; }
    }
}

export component ContextMenu inherits Window {
    title: "Wowie Context Menu";
    no-frame: true;
    forward-focus: focus-scope;
    default-font-family: root.ui-font-family;
    default-font-size: root.ui-font-size;
    in property <length> menu-width: 292px;
    in property <string> ui-font-family: "";
    in property <length> ui-font-size: 14px;
    width: root.menu-width;
    height: max(40px, 8px + root.actions.length * root.menu-item-height);
    background: transparent;

    in property <bool> dark-mode: true;
    in property <color> accent-color: #0067c0;
    in property <[ContextActionRow]> actions;
    in property <bool> keyboard-invoked: false;
    callback action-requested(string);
    callback dismissed;
    private property <int> selected-action-index: 0;

    private property <color> canvas: root.dark-mode ? #202020 : #f8f9fb;
    private property <color> hover: root.dark-mode ? #383838 : #eef1f5;
    private property <length> menu-item-height: 32px;
    private property <color> border: root.dark-mode ? #484848 : #d9dde5;
    private property <color> text-primary: root.dark-mode ? #f5f5f5 : #1b1b1f;
    private property <color> text-secondary: root.dark-mode ? #b6b6b6 : #5d5f66;

    changed actions => {
        root.selected-action-index = root.keyboard-invoked
            ? root.actions.length == 0 ? -1 : root.actions[0].kind == "section" ? (root.actions.length > 1 ? 1 : -1) : 0
            : -1;
        focus-scope.focus();
    }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.dismissed(); accept }
            if (event.text == Key.DownArrow && root.actions.length > 0) {
                let candidate = root.selected-action-index + 1;
                let wrapped = candidate >= root.actions.length ? 0 : max(candidate, 0);
                let next = root.actions[wrapped].kind == "section" ? (wrapped + 1 >= root.actions.length ? 0 : wrapped + 1) : wrapped;
                root.selected-action-index = next;
                accept
            }
            if (event.text == Key.UpArrow && root.actions.length > 0) {
                let candidate = root.selected-action-index - 1;
                let wrapped = candidate < 0 ? root.actions.length - 1 : candidate;
                let next = root.actions[wrapped].kind == "section" ? (wrapped - 1 < 0 ? root.actions.length - 1 : wrapped - 1) : wrapped;
                root.selected-action-index = next;
                accept
            }
            if (event.text == Key.Home && root.actions.length > 0) {
                root.selected-action-index = root.actions[0].kind == "section" ? (root.actions.length > 1 ? 1 : -1) : 0;
                accept
            }
            if (event.text == Key.End && root.actions.length > 0) {
                let last = root.actions.length - 1;
                root.selected-action-index = root.actions[last].kind == "section" ? max(last - 1, 0) : last;
                accept
            }
            if (event.text == Key.Return && root.selected-action-index >= 0 && root.actions[root.selected-action-index].kind != "section") {
                root.action-requested(root.actions[root.selected-action-index].id);
                accept
            }
            reject
        }

        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            background: root.canvas;
            border-color: root.border;
            border-width: 1px;
            border-radius: 8px;

            for action[index] in root.actions : Rectangle {
            x: 1px; y: 4px + index * root.menu-item-height;
            width: parent.width - 2px; height: root.menu-item-height;
            background: action.kind == "section" ? root.canvas : index == root.selected-action-index ? root.hover : action-area.has-hover ? root.hover : root.canvas;
            border-radius: 6px;
            action-area := TouchArea {
                enabled: action.kind != "section";
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                        root.action-requested(action.id);
                        EventResult.accept
                    } else {
                        EventResult.reject
                    }
                }
            }
            BuiltinIcon { x: 14px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; kind: action.icon_kind; }
            if action.icon_kind == "" : Image { x: 14px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: action.icon; image-fit: contain; }
            Text {
                x: 36px; y: action.subtitle == "" ? 0px : 2px; width: action.shortcut == "" ? parent.width - 50px : parent.width - 162px;
                height: action.subtitle == "" ? parent.height : 16px;
                text: action.kind == "section" ? @tr("Other launch entries") : action.id == "add-favorite" ? @tr("Add to favorites") : action.id == "remove-favorite" ? @tr("Remove from favorites") : action.id == "open-directory" ? @tr("Open containing folder") : action.id == "run-as-admin" ? @tr("Run as administrator") : action.id == "copy-title" ? @tr("Copy title") : action.id == "copy-path" ? @tr("Copy path") : action.id == "copy-url" ? @tr("Copy URL") : action.title;
                color: action.kind == "section" ? root.text-secondary : root.text-primary;
                font-size: action.kind == "section" ? 0.7857rem : 0.9286rem;
                vertical-alignment: center; overflow: elide;
            }
            Text { x: 36px; y: 17px; width: action.shortcut == "" ? parent.width - 50px : parent.width - 162px; height: 12px; text: action.subtitle; color: root.text-secondary; font-size: 0.7143rem; vertical-alignment: center; overflow: elide; visible: action.subtitle != ""; }
            Text { x: parent.width - 120px; y: 0px; width: 108px; height: parent.height; text: action.shortcut; color: root.text-secondary; font-size: 0.7143rem; horizontal-alignment: right; vertical-alignment: center; overflow: elide; visible: action.shortcut != ""; }
            }
        }
    }

}
